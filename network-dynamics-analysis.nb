Cell[TextData[{
 "Note that the largest eigenvalues of the adjacency matrices in SampleA most \
frequently take a value close to 10, which is in line with what we would \
anticipate. Note that an Erdos-R\[EAcute]nyi network with ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "6f641587-e7ad-4e72-9498-34234c62f702"],
 " agents that has no self-loops and has probability ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "c1e21aec-9b3e-4073-991e-a63d2d5415fb"],
 " of any given link existing has the property that it is expected to have \
largest eigenvalue in absolute value given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"n", "-", "1"}], ")"}], "p"}], TraditionalForm]],ExpressionUUID->
  "16662fd5-c416-4950-9bda-b48fcc573df9"],
 ", which in our case yields 9.9. Thus, the leftmost figure above is in line \
with our expectation. Meanwhile, the largest eigenvalues of the adjacency \
matrices in SampleB tend to be smaller than those in SampleA. This is a \
result of the fact that the links in a SampleB network are expected to be a \
subset of the links that exist in a SampleA network, since the probability \
that a given link exists in SampleA is at least as large as the probability \
that the corresponding link exists in SampleB, and removing a link from a \
network will always have the effect of reducing the largest eigenvalue of the \
corresponding adjacency matrix, as we will see. Finally, note the greater \
variability in the value of the largest eigenvalue for adjacency matrices in \
SampleB. This most likely results from the fact that we chose to generate a \
new scattering of points for each subsequent network generated in the sample. \
Now, in order to derive the assortativity for each network in our samples, we \
must define three functions, the first being the mean number of three-step \
paths through a link:"
}], "Text",
 CellChangeTimes->{{3.8193641465343018`*^9, 3.819364173822291*^9}, {
  3.8194585936847258`*^9, 3.819458614568407*^9}, {3.819553941718385*^9, 
  3.8195539511776915`*^9}, {3.8195539924582195`*^9, 3.8195540938504477`*^9}, {
  3.8195542276321697`*^9, 3.8195544306302257`*^9}, {3.8195544621146507`*^9, 
  3.819554525626825*^9}, {3.8195545568860598`*^9, 3.81955467800873*^9}, {
  3.8196248526264906`*^9, 3.8196248786259527`*^9}, {3.819624910532646*^9, 
  3.8196249440859127`*^9}, {3.8196289903835707`*^9, 3.8196289948655853`*^9}, {
  3.8196290437129354`*^9, 3.819629045650755*^9}, {3.819638280671174*^9, 
  3.819638311826845*^9}, {3.819638349777343*^9, 3.819638351281358*^9}, {
  3.819638397984409*^9, 3.8196384028214703`*^9}, {3.819638457855276*^9, 
  3.8196384829833217`*^9}},
 FontSize->11,ExpressionUUID->"15374a1b-3fc9-4862-9488-4fcf69407359"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox[
    SubscriptBox["E", "T"],
    FontWeight->"Bold"], "[", "A_", "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"Total", "[", "A", "]"}], ".", "A", ".", 
    RowBox[{"Total", "[", 
     RowBox[{"Transpose", "[", "A", "]"}], "]"}]}], 
   RowBox[{"Total", "[", 
    RowBox[{"Total", "[", "A", "]"}], "]"}]]}]], "Input",
 FontSize->11,
 CellLabel->
  "In[869]:=",ExpressionUUID->"e9b858cc-b688-48fd-9cac-8969b0927a7f"],

Cell["\<\
We also require the average of the in-degrees and out-degrees of two nodes \
connected by a link:\
\>", "Text",
 CellChangeTimes->{{3.819364196503606*^9, 3.819364208814668*^9}},
 FontSize->11,ExpressionUUID->"a9cf6d73-1b37-4d1d-8b4c-02f074337caf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["E", "S"], "[", "A_", "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"Total", "[", "A", "]"}], ".", 
    RowBox[{"Total", "[", 
     RowBox[{"Transpose", "[", "A", "]"}], "]"}]}], 
   RowBox[{"Total", "[", 
    RowBox[{"Total", "[", "A", "]"}], "]"}]]}]], "Input",
 PageWidth->PaperWidth,
 FontSize->11,
 CellLabel->
  "In[870]:=",ExpressionUUID->"56e71d04-de73-4579-8fb0-e10ec71e71c7"],

Cell[TextData[{
 "Finally, we require the variance in the mean number of in-links and \
out-links at a link ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[Rule]", "j"}], TraditionalForm]],ExpressionUUID->
  "a9ed54c9-6a72-4db1-bf31-c8ebc8252c72"],
 ":"
}], "Text",
 CellChangeTimes->{{3.819364235235299*^9, 3.8193642401731234`*^9}},
 FontSize->11,ExpressionUUID->"cdc926d0-2e55-4d97-adb8-26ba5afaf395"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["Var", "S"], "[", "A_", "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{
     FractionBox["1", "4"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"Length", "[", "A", "]"}]], 
        SuperscriptBox[
         RowBox[{
          RowBox[{"Total", "[", "A", "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], "3"]}], "+", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"Length", "[", "A", "]"}]], 
        SuperscriptBox[
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Transpose", "[", "A", "]"}], "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], "3"]}]}], ")"}]}], 
    RowBox[{"Total", "[", 
     RowBox[{"Total", "[", "A", "]"}], "]"}]], "+", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     SubscriptBox["E", "T"], "[", "A", "]"}]}], "-", 
   SuperscriptBox[
    RowBox[{
     SubscriptBox["E", "S"], "[", "A", "]"}], "2"]}]}]], "Input",
 FontSize->11,
 CellLabel->
  "In[871]:=",ExpressionUUID->"17c377d3-6bc1-48ab-aec5-130a5dbb01a7"],

Cell[TextData[{
 "Then, the assortativity for a network corresponding to the adjacency matrix \
",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "a7a09034-a5e0-445f-80a6-d4108309d877"],
 " is given by the function below:"
}], "Text",
 CellChangeTimes->{{3.8193642443080244`*^9, 3.8193642691805105`*^9}, {
  3.819364301607131*^9, 3.819364314552458*^9}, {3.81963851638894*^9, 
  3.819638517961732*^9}},
 FontSize->11,ExpressionUUID->"0f3572e2-5c35-4616-be3d-d6714f8ec08e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Assortativity", "[", "A_", "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{
     SubscriptBox["E", "T"], "[", "A", "]"}], "-", 
    SuperscriptBox[
     RowBox[{
      SubscriptBox["E", "S"], "[", "A", "]"}], "2"]}], 
   RowBox[{
    SubscriptBox["Var", "S"], "[", "A", "]"}]]}]], "Input",
 CellChangeTimes->{{3.8179018594014997`*^9, 3.817901887914255*^9}},
 FontSize->11,
 CellLabel->
  "In[872]:=",ExpressionUUID->"40ded6a0-75a2-4cb6-a8f5-ac9b266c1152"],

Cell["\<\
The following commands calculate the coefficient of assortativity for every \
network in SampleA and SampleB respectively:\
\>", "Text",
 CellChangeTimes->{{3.81936433706355*^9, 3.8193643708601274`*^9}},
 FontSize->11,ExpressionUUID->"269884f4-6b49-4526-8876-f5efd6ae9f86"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AS1", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Assortativity", ",", "SampleA"}], "]"}]}], ";", 
  RowBox[{"AS2", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Assortativity", ",", "SampleB"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8179026591040773`*^9, 3.817902688951339*^9}, 
   3.8190396848138595`*^9},
 FontSize->11,
 CellLabel->"In[44]:=",ExpressionUUID->"d290b0da-b019-4d6c-bd73-f4498ad9dec7"],

