Cell[TextData[{
 "Note that for an assortative network with positive ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "425991bb-ff1b-41bc-b25b-6964203aca3a"],
 " and ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]],ExpressionUUID->
  "2450b01a-97a2-45ba-8e7d-f11b9087c13c"],
 ", these results would be reversed."
}], "Text",
 CellChangeTimes->{{3.819550164566766*^9, 3.8195502005441675`*^9}, 
   3.8195601124849234`*^9},
 FontSize->11,ExpressionUUID->"0cad1aaa-00cb-49ec-b765-9c3d986642da"],

