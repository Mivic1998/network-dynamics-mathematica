 FontSize->11,ExpressionUUID->"e00b96d1-c311-4a0e-adbc-23498ccae17d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"List2", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"T", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"SampleD", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}], 
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"SampleD", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
            FractionBox["1", "2"]], ",", 
           RowBox[{"-", 
            RowBox[{"M2", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "k"}], "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "100"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"List2", ",", "T"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "SampleD", "]"}]}], "}"}]}], "]"}], ";", 
  RowBox[{"L2", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"List2", ",", 
     RowBox[{"PlotRange", "\[Rule]", "Full"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<(\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(in\)]\)\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(out\)]\)\!\(\*SuperscriptBox[\()\), FractionBox[\(1\), \(2\)]]\)\>\"", ",", 
        "\"\<\!\(\*SubscriptBox[\(I\), \(k\)]\)\>\""}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
