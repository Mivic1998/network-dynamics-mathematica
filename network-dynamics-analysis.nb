   3.819615678609743*^9, 3.819615700245877*^9}, {3.8196157787299633`*^9, 
   3.819615816619588*^9}, {3.819616105950739*^9, 3.8196161427044353`*^9}, {
   3.8196161950793533`*^9, 3.819616195470307*^9}, {3.81961623322134*^9, 
