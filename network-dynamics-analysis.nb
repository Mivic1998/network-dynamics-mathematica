Cell[BoxData[
 RowBox[{
  RowBox[{"U", "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "1"}], "10"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{
        RowBox[{"2", "n"}], "-", "1"}]], 
      RowBox[{"TensorProduct", "[", 
       RowBox[{
        RowBox[{"Eva", "[", 
         RowBox[{"400", ",", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}], "2"], "+", "i"}]}], "]"}], ",", 
        RowBox[{"Ev", "[", 
         RowBox[{"20", ",", 
          RowBox[{
           RowBox[{"2", "n"}], "-", "i"}], ",", "i"}], "]"}]}], "]"}]}]}], 
    "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "1"}], "10"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "1"}], 
       RowBox[{
        RowBox[{"2", "n"}], "-", "1"}]], 
      RowBox[{"TensorProduct", "[", 
       RowBox[{
        RowBox[{"Eva", "[", 
         RowBox[{"400", ",", 
          RowBox[{"201", "-", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}], "2"], "-", "i"}]}], "]"}], ",", 
        RowBox[{"Ev", "[", 
         RowBox[{"20", ",", 
          RowBox[{"21", "-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "n"}], "-", "i"}], ")"}]}], ",", 
          RowBox[{"21", "-", "i"}]}], "]"}]}], "]"}]}]}]}]}], ";", 
  RowBox[{"V", "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "1"}], "10"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{
        RowBox[{"2", "n"}], "-", "1"}]], 
      RowBox[{"TensorProduct", "[", 
       RowBox[{
        RowBox[{"Eva", "[", 
         RowBox[{"400", ",", 
          RowBox[{"201", "+", 
           RowBox[{"n", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}], "+", "i"}]}], "]"}], ",", 
        RowBox[{"Ev", "[", 
         RowBox[{"20", ",", 
          RowBox[{
           RowBox[{"2", "n"}], "-", "i"}], ",", 
          RowBox[{"i", "+", "1"}]}], "]"}]}], "]"}]}]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "1"}], "9"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{
        RowBox[{"2", "n"}], "-", "1"}]], 
      RowBox[{"TensorProduct", "[", 
       RowBox[{
        RowBox[{"Eva", "[", 
         RowBox[{"400", ",", 
          RowBox[{"400", "-", 
           RowBox[{"n", 
            RowBox[{"(", 
             RowBox[{"n", "-", "1"}], ")"}]}], "-", "i"}]}], "]"}], ",", 
        RowBox[{"Ev", "[", 
         RowBox[{"20", ",", 
          RowBox[{"21", "-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "n"}], "-", "i"}], ")"}]}], ",", 
          RowBox[{"20", "-", "i"}]}], "]"}]}], "]"}]}]}]}]}], ";"}]], "Input",
