   3.819617202595643*^9, 3.819617393291642*^9}, {3.8196174616796947`*^9, 
   3.819617812438555*^9}, {3.819628259749775*^9, 3.819628262057605*^9}, {
   3.819628320415567*^9, 3.819628347861163*^9}, 3.8196425971895094`*^9, {
   3.8196426394883766`*^9, 3.8196426431116853`*^9}, {3.81964269033342*^9, 
   3.819642691321742*^9}, 3.9987369040947495`*^9},
 FontSize->11,ExpressionUUID->"4ace63ff-6687-4ab8-9395-5e956705ce99"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "   ",
 StyleBox["      Toroidal Lattice Comparison",
  FontSize->20,
  FontColor->RGBColor[0.5019607843137255, 0., 0.]]
}], "Subtitle",
 CellChangeTimes->{{3.998736671139282*^9, 3.9987366930465355`*^9}, {
   3.998736898420906*^9, 3.998736902413233*^9}, 
   3.9987451294386883`*^9},ExpressionUUID->"95cd69d6-6008-d547-a363-\
bf0aa1a6e86d"],

Cell["\<\
Finally, I repeat the evolution analysis using a toroidal lattice. Connecting \
opposite boundaries removes the edge effects present in the square lattice \
and gives every node the same initial degree, allowing me to examine how the \
network\[CloseCurlyQuote]s initial topology affects its subsequent evolution.\
\>", "Text",
 CellChangeTimes->{{3.598452093952716*^9, 3.598452204485716*^9}, {
   3.652420633161273*^9, 3.6524206868278103`*^9}, {3.652420752564468*^9, 
   3.6524207756666994`*^9}, {3.6524208270572195`*^9, 3.652420860190551*^9}, {
   3.6524210786297*^9, 3.6524210940307*^9}, {3.652967960434185*^9, 
   3.652968115298876*^9}, {3.6529733486104965`*^9, 3.6529733896518383`*^9}, {
   3.683718120594956*^9, 3.683718123730938*^9}, {3.6837181586916018`*^9, 
   3.683718175369363*^9}, {3.6837741655485477`*^9, 3.683774166986993*^9}, {
   3.683774748963084*^9, 3.683774773993095*^9}, {3.683774831383595*^9, 
   3.68377486405478*^9}, {3.683774918249523*^9, 3.683774954160534*^9}, {
   3.6845117734469385`*^9, 3.684511835768572*^9}, 3.6845119826187377`*^9, {
   3.6846037549010444`*^9, 3.6846038176765676`*^9}, {3.6851288323337092`*^9, 
   3.6851291036115475`*^9}, {3.6851297173722887`*^9, 3.685129718458522*^9}, {
   3.6851314218370667`*^9, 3.685131447867895*^9}, {3.685131509731413*^9, 
   3.685131517663705*^9}, {3.685185089630221*^9, 3.6851852810272207`*^9}, {
   3.697183568757872*^9, 3.697183594886485*^9}, {3.7472105780738697`*^9, 
   3.7472105832291517`*^9}, {3.753013281511385*^9, 3.7530133238314266`*^9}, {
   3.753013729293499*^9, 3.7530137773346033`*^9}, {3.753013815932062*^9, 
   3.7530139762751236`*^9}, {3.753014067140837*^9, 3.753014068139863*^9}, {
   3.753014114597804*^9, 3.7530142710179152`*^9}, {3.7530144253634095`*^9, 
   3.753014429107126*^9}, {3.7530147773772297`*^9, 3.7530147774645844`*^9}, {
   3.755154789567511*^9, 3.755154859269661*^9}, {3.7680401569374084`*^9, 
   3.768040157385848*^9}, {3.7680402358806114`*^9, 3.7680402373383317`*^9}, {
   3.77495920130507*^9, 3.7749597620291457`*^9}, {3.77513286750156*^9, 
   3.775132898021247*^9}, {3.778866087425239*^9, 3.778866259527502*^9}, {
   3.778866295466211*^9, 3.7788664058104787`*^9}, {3.8014866697031603`*^9, 
   3.8014866716380296`*^9}, {3.801486916405057*^9, 3.801486975596875*^9}, {
   3.801487017370192*^9, 3.801487047063816*^9}, {3.8014871633479366`*^9, 
   3.801487181410654*^9}, {3.801487215713957*^9, 3.80148721859031*^9}, {
   3.8014877143143015`*^9, 3.8014880032888165`*^9}, {3.8014882268073134`*^9, 
   3.8014882413764153`*^9}, {3.8033793583540897`*^9, 
   3.8033794273583603`*^9}, {3.8033796228154287`*^9, 3.803379640089072*^9}, {
   3.8033805615415697`*^9, 3.803380646874024*^9}, {3.803630406717191*^9, 
   3.8036304192536693`*^9}, {3.803630518297773*^9, 3.803630518609902*^9}, {
   3.8036305600929832`*^9, 3.8036305600929832`*^9}, {3.8036307783781133`*^9, 
   3.8036308606011815`*^9}, {3.8053681946307354`*^9, 
   3.8053682120110083`*^9}, {3.8053682718437815`*^9, 
   3.8053683269435396`*^9}, {3.8053683619824047`*^9, 3.805368707126303*^9}, {
   3.80536876819514*^9, 3.8053688654388213`*^9}, {3.805368933520688*^9, 
   3.805368980534671*^9}, {3.8053690139001265`*^9, 3.8053691639045515`*^9}, {
   3.8053692441480365`*^9, 3.80536931864217*^9}, {3.8168635272309895`*^9, 
   3.8168635845935636`*^9}, {3.816863685372053*^9, 3.81686375134494*^9}, {
   3.81686388120994*^9, 3.816863947167095*^9}, {3.816863997606894*^9, 
   3.816864003864453*^9}, {3.8168640429415116`*^9, 3.8168641026916676`*^9}, {
   3.816864152463027*^9, 3.8168641981214075`*^9}, {3.816864244975381*^9, 
   3.816864375626174*^9}, {3.8168651879418955`*^9, 3.8168652172367887`*^9}, {
   3.816865338989642*^9, 3.816865387944996*^9}, {3.8168670867639265`*^9, 
   3.8168671291006346`*^9}, {3.9987366454157867`*^9, 3.9987366643423576`*^9}, 
   3.9987401445469723`*^9},
 TextJustification->0.,
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"39c065f5-2046-41ce-962d-6fca6c35ca5b"],

Cell[TextData[{
 "We generate a torus consisting of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["m", "2"], TraditionalForm]],ExpressionUUID->
  "7abc7213-ee63-411f-9176-82a36eede54f"],
 " nodes by taking the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "\[Times]", "m"}], TraditionalForm]],ExpressionUUID->
  "dddb3cdb-3d4e-4633-8314-1890510d7737"],
 " square lattice that we generated above and connecting its opposite edges, \
which results in a network in which every node has exactly four symmetric \
links. The command below does this by taking the node with label ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"m", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "5ee3acb5-d65d-485f-a613-d0169bbd116d"],
 " and connecting it to the node with label ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "0f0b9201-7c2f-42dd-81ce-a3be1d18870f"],
 "  for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LessSlantEqual]", "j", "\[LessSlantEqual]", "m"}], 
   TraditionalForm]],ExpressionUUID->"ec9bb9dc-0e99-406a-8f10-2342831d8552"],
 " while also taking the node with label ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "m"}], ")"}], TraditionalForm]],ExpressionUUID->
  "67fcf2f6-2f36-448c-8e7f-f1caa5e2b3bf"],
 " and connecting it to the node with label ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "1"}], ")"}], TraditionalForm]],ExpressionUUID->
  "f8fcaf1d-322b-4904-9758-a600f3ad060e"],
 " for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LessSlantEqual]", "i", "\[LessSlantEqual]", "m"}], 
   TraditionalForm]],ExpressionUUID->"bb43f8ed-3bdf-4f0a-93b2-f64b89e7cf74"],
 ". It does this by taking the command used to generate the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "\[Times]", "m"}], TraditionalForm]],ExpressionUUID->
  "272ac80b-6869-4624-b3aa-4f5c509ffd1f"],
 " square lattice produced above and replacing the components ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "794ed871-62d1-4f65-927f-2a1017aea46b"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "32778979-cf56-4de9-bfd6-80fd467941ed"],
 " in each expression ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Ev", "[", 
    RowBox[{"m", ",", "x", ",", "y"}], "]"}], TraditionalForm]],
  ExpressionUUID->"9ccb113e-93c3-4ec6-93b8-b89ef7c3c63e"],
 " that is present in the sum that it comprises with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Mod", "[", 
    RowBox[{"x", ",", "m", ",", "1"}], "]"}], TraditionalForm]],
  ExpressionUUID->"77acafae-2c1e-43e2-94a6-a2616b7154af"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Mod", "[", 
    RowBox[{"y", ",", "m", ",", "1"}], "]"}], TraditionalForm]],
  ExpressionUUID->"267dd860-5558-4eee-9bfb-16de29984fc5"],
 " respectively. The command ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Mod", "[", 
    RowBox[{"t", ",", "m", ",", "1"}], "]"}], TraditionalForm]],
  ExpressionUUID->"15b36f17-f72d-41b9-ad44-dca0e4abb8ec"],
 " yields a result ",
 Cell[BoxData[
  FormBox["w", TraditionalForm]],ExpressionUUID->
  "45d5152a-fa19-4287-9a09-bdb55b4ef947"],
 " such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LessSlantEqual]", "w", "<", "m"}], TraditionalForm]],
  ExpressionUUID->"fd18f922-4d76-47d2-896b-6bf17f04835e"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"w", " ", "mod", " ", "m"}], "=", 
    RowBox[{"t", " ", "mod", " ", "m"}]}], TraditionalForm]],ExpressionUUID->
  "de0c3376-1889-440c-b656-2be7a7b9aee1"],
 ", meaning that ",
 Cell[BoxData[
  FormBox["it", TraditionalForm]],ExpressionUUID->
  "37d1da34-dc3a-4aad-9c5c-9a23dda68dbe"],
 " will return a value of ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],ExpressionUUID->
  "0db9e04e-ade7-47b7-a71f-124ef12a28d0"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LessSlantEqual]", "t", "\[LessSlantEqual]", "m"}], 
   TraditionalForm]],ExpressionUUID->"bed7af5b-06e2-48b8-a051-6b0446424000"],
 ", a value of ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "b465d031-d06d-4c3b-b7ea-be9024f424d5"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "762a23ae-7749-4cea-b002-5a9f8dab10f7"],
 " and a value of ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "ff5643c7-7093-475a-ab3d-ab42d4acb0c5"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{"m", "+", "1"}]}], TraditionalForm]],ExpressionUUID->
  "ba981651-c0f5-4a07-902e-51234151ef79"],
 ". Thus, using the command below, we ensure that all connections of the \
square lattice exist in the case of the torus, but now for example the node ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"m", ",", "m"}], ")"}], TraditionalForm]],ExpressionUUID->
  "edd6250f-ec0e-4210-afbd-7af8ca5ca1b4"],
 " which occupies two edges will be connected to the nodes with labels ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", ",", "m"}], ")"}], TraditionalForm]],ExpressionUUID->
  "41f80b02-e932-48da-8561-945a79a9d698"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"m", ",", "1"}], ")"}], TraditionalForm]],ExpressionUUID->
  "e1d0fc13-919a-41b2-a7c1-e5185b791304"],
 ", the first of which, for demonstration, is represented in the command ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "2"], "[", "m", "]"}], TraditionalForm]],ExpressionUUID->
  "04441b9b-1d9c-46ec-b14d-8362126e0697"],
 " by the expression: \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"TensorProduct", "[", 
    RowBox[{
     RowBox[{"Ev", "[", 
      RowBox[{"m", ",", 
       RowBox[{"Mod", "[", 
        RowBox[{"m", ",", "m", ",", "1"}], "]"}], ",", 
       RowBox[{"Mod", "[", 
        RowBox[{"m", ",", "m", ",", "1"}], "]"}]}], "]"}], ",", 
     RowBox[{"Ev", "[", 
      RowBox[{"m", ",", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"m", "+", "1"}], ",", "m", ",", "1"}], "]"}], ",", 
       RowBox[{"Mod", "[", 
        RowBox[{"m", ",", "m", ",", "1"}], "]"}]}], "]"}]}], "]"}], 
   TraditionalForm]],ExpressionUUID->"797bf411-65ea-4657-ab3f-88a312d342c2"],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"=", 
     RowBox[{"TensorProduct", "[", 
      RowBox[{
       RowBox[{"Ev", "[", 
        RowBox[{"m", ",", "m", ",", "m"}], "]"}], ",", 
       RowBox[{"Ev", "[", 
        RowBox[{"m", ",", "1", ",", "m"}], "]"}]}], "]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"fa218f3d-7894-4d19-a4da-2cf763cc3c27"],
 "\n\nThe command in question is given by:"
}], "Text",
 CellChangeTimes->CompressedData["
1:eJwdzksowwEAx/F//7D8SUM5yGNkZt7NcnGQ5NEOmy2JWaYhRGjMxYqViMhw
obyaGk2LvGOtMYTcsMkuHDxi7G8HyaP8f//Dt8/1m6BpVzSQBEHwmGDo2VJy
UZe3gNI5WbWlbWUOxmf5rQLeSzhqmG0ZYk0Zt9AHjDzq1Q+7Lzu+4KhP9AMX
BteJQ8a4om0SholHR+Bcv3kS3j1fTMGAMcMsVJS2rsBlYaoVetc+1uHwkHEL
EjmPJ3Bz55R0MpoEFAcKrIJQaDSouLDa0xINV0/dArgg8rDqQyQy+LmoZLVd
1/lcjOHfAb9QHNxEuvE3bWLV5ydxIV/aGAl3N7bTYARpy4Jr3UIx7FVr8uC+
sKQQZjuui2FNX6wUXrmbamFFT2c9DKqdYA3ba9XCxPQoAzQ6XFbIfc9dhfLP
8w1IPcR7IF2hfoDNKUesWVUDMTeMgeZjHpyp+ePDcqU/A75dpIsgbRfK4NOj
8UWl8xZU2udZ5zNN79BukdPwH3O6FA8=
  "],
 FontSize->11,ExpressionUUID->"1c1bb96e-7c6b-4df9-8863-37129e80c6f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["B", "2"], "[", "m_", "]"}], ":=", 
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"j", "=", "1"}], "m"], 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "m"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"TensorProduct", "[", 
       RowBox[{
        RowBox[{"Ev", "[", 
         RowBox[{"m", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"j", ",", "m", ",", "1"}], "]"}], ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"k", ",", "m", ",", "1"}], "]"}]}], "]"}], ",", 
        RowBox[{"Ev", "[", 
         RowBox[{"m", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"j", "-", "1"}], ",", "m", ",", "1"}], "]"}], ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"k", ",", "m", ",", "1"}], "]"}]}], "]"}]}], "]"}], "+", 
      RowBox[{"TensorProduct", "[", 
       RowBox[{
        RowBox[{"Ev", "[", 
         RowBox[{"m", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"j", ",", "m", ",", "1"}], "]"}], ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"k", ",", "m", ",", "1"}], "]"}]}], "]"}], ",", 
        RowBox[{"Ev", "[", 
         RowBox[{"m", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"j", "+", "1"}], ",", "m", ",", "1"}], "]"}], ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"k", ",", "m", ",", "1"}], "]"}]}], "]"}]}], "]"}], "+", 
      RowBox[{"TensorProduct", "[", 
       RowBox[{
        RowBox[{"Ev", "[", 
         RowBox[{"m", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"j", ",", "m", ",", "1"}], "]"}], ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"k", ",", "m", ",", "1"}], "]"}]}], "]"}], ",", 
        RowBox[{"Ev", "[", 
         RowBox[{"m", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"j", ",", "m", ",", "1"}], "]"}], ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"k", "-", "1"}], ",", "m", ",", "1"}], "]"}]}], "]"}]}], 
       "]"}], "+", 
      RowBox[{"TensorProduct", "[", 
       RowBox[{
        RowBox[{"Ev", "[", 
         RowBox[{"m", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"j", ",", "m", ",", "1"}], "]"}], ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"k", ",", "m", ",", "1"}], "]"}]}], "]"}], ",", 
        RowBox[{"Ev", "[", 
         RowBox[{"m", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"j", ",", "m", ",", "1"}], "]"}], ",", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"k", "+", "1"}], ",", "m", ",", "1"}], "]"}]}], "]"}]}], 
       "]"}]}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.817392964580963*^9, 3.817392983889911*^9}},
 FontSize->11,
 CellLabel->
  "In[671]:=",ExpressionUUID->"f495a3ef-e313-4e99-8cd3-83630524f7c1"],

Cell[TextData[{
 "The command below now generates a torus with ",
 Cell[BoxData[
  FormBox["400", TraditionalForm]],ExpressionUUID->
  "00bb0bc2-ff65-4593-9393-faa0f62d2df9"],
 " nodes:"
}], "Text",
 CellChangeTimes->{{3.819356814807028*^9, 3.8193568253368535`*^9}},
 FontSize->11,ExpressionUUID->"1dec1ced-b7fe-4f3c-9d5f-d78f2627ec19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"B2", "=", 
   RowBox[{
    SubscriptBox["B", "2"], "[", "20", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8181842514850135`*^9, 3.818184270560994*^9}},
 FontSize->11,
 CellLabel->
  "In[672]:=",ExpressionUUID->"3e734011-6536-49f4-8899-f8aaf072522a"],

Cell[TextData[{
 "We now apply the command ",
 Cell[BoxData[
  FormBox["F", TraditionalForm]],ExpressionUUID->
  "47d85bc7-9ffd-45a4-aeb8-c7c553b2cc24"],
 " to the torus generated above, again running the evolution for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", "1000"}], TraditionalForm]],ExpressionUUID->
  "a43a3b57-1210-4daf-b5fc-2c8d44d9aedb"],
 " time steps and setting the number of reconnections at each iteration to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "4"}], TraditionalForm]],ExpressionUUID->
  "42d33c86-31f5-46f5-a182-05e6a7b6c9dc"],
 ":"
}], "Text",
 CellChangeTimes->{{3.8193635085626884`*^9, 3.819363645375645*^9}, {
  3.8196284317089024`*^9, 3.8196284317887287`*^9}},
 FontSize->11,ExpressionUUID->"61ba0aea-7f7e-4325-9d73-8750c5ebb114"],

Cell[BoxData[
 RowBox[{"F", "[", 
  RowBox[{"1000", ",", "4", ",", "B2"}], "]"}]], "Input",
 CellChangeTimes->{{3.818184379018479*^9, 3.8181843790713654`*^9}},
 FontSize->11,
 CellLabel->
  "In[673]:=",ExpressionUUID->"c8357b05-a89a-432a-9b7e-746c65c7ce2f"],

Cell["\<\
We call the resultant list NetworkEvolutionT in this case. Now, just as we \
did in the square lattice case, we calculate the Watts-Strogatz coefficient \
for each node in each iteration of the Torus\[CloseCurlyQuote] evolution \
below:\
\>", "Text",
 CellChangeTimes->{{3.8193679159677315`*^9, 3.8193679174029303`*^9}, {
  3.8193679854179606`*^9, 3.819368073369603*^9}, {3.8194841533796287`*^9, 
  3.8194841613001137`*^9}, {3.819628201222314*^9, 3.8196282112804112`*^9}, {
  3.8196284481519246`*^9, 3.8196284515987034`*^9}},
 FontSize->11,ExpressionUUID->"1532d1b7-e1e6-4547-9561-58ae0874ae7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["T", "2"], "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Diagonal", ",", 
     RowBox[{"Map", "[", 
      RowBox[{"p", ",", "NetworkEvolutionT"}], "]"}]}], "]"}]}], ";", 
  RowBox[{
   SubscriptBox["TS", "2"], "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Diagonal", ",", 
     RowBox[{"Map", "[", 
      RowBox[{"TwoStep", ",", "NetworkEvolutionT"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"WS2", "=", 
   FractionBox[
    SubscriptBox["T", "2"], 
    SubscriptBox["TS", "2"]]}], ";", 
  RowBox[{
   SubscriptBox["WS", "2"], "=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{"WS2", ",", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"WS2", ",", "Indeterminate"}], "]"}], "\[Rule]", "0"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8181844084820976`*^9, 3.8181844089019766`*^9}, {
  3.8181846427455235`*^9, 3.818184643586277*^9}, {3.819120908737596*^9, 
  3.81912092256047*^9}},
 FontSize->11,
 CellLabel->
  "In[682]:=",ExpressionUUID->"5ba7d621-df4f-49bf-8ab3-c7eccad39a90"],

Cell[TextData[{
 "The command below generates a matrix ",
 Cell[BoxData[
  FormBox["MT", TraditionalForm]],ExpressionUUID->
  "4e17a230-2207-40f0-a894-92fee3e3a96f"],
 ", where entry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "e80d06c6-1e63-411e-93d3-f37536c63ef2"],
 " of the matrix in question yields the dynamical importance of node ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "520d8fdf-d340-4940-b4b2-f34f40ffd5fb"],
 " of the network corresponding to the adjacency matrix ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d3237e8b-422c-473a-bcd2-6b12fd680a40"],
 " in NetworkEvolutionT:"
}], "Text",
 CellChangeTimes->{{3.81956134627063*^9, 3.81956136073993*^9}, {
   3.819642817508243*^9, 3.819642818338055*^9}, 3.8196431130657434`*^9, {
   3.819643188977125*^9, 3.8196431915851507`*^9}},
 FontSize->11,ExpressionUUID->"1e8a1aff-fba0-459f-b54a-3863dcb5d45d"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"\[CapitalDelta]EvnT", "=", 
    RowBox[{"{", "}"}]}],
   FontWeight->"Bold"], 
  StyleBox[";",
   FontWeight->"Bold"], 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", "=", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", "[", 
          RowBox[{"NetworkEvolutionT", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"f", "[", 
       RowBox[{
        RowBox[{"NetworkEvolutionT", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\[Lambda]"}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "NetworkEvolutionT", "]"}]}], "}"}]}], "]"}], 
  ";", 
  RowBox[{"MT", "=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Re", "[", 
      StyleBox["\[CapitalDelta]EvnT",
       FontWeight->"Bold"], 
      StyleBox["]",
       FontWeight->"Bold"]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "NetworkEvolutionT", "]"}], ",", "400"}], 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8182001059894953`*^9, 3.8182001073308744`*^9}, 
   3.8191208969004116`*^9, {3.8194836316252737`*^9, 3.819483635199072*^9}},
 FontSize->11,
 CellLabel->
  "In[677]:=",ExpressionUUID->"fffba9ec-bc2d-459a-86c0-b8c407c2e241"],

Cell[TextData[{
 "The following set of commands now generates four lists, each of which has \
element ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "a2b10480-cae0-43e1-9cca-b414a1d7c866"],
 " that yields the correlation of the dynamical importance of a node with \
some variable for the ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "fd5df985-4a53-4fa1-af82-182f02322149"],
 "-th network in the list NetworkEvolutionT. For the lists ",
 Cell[BoxData[
  FormBox[
   RowBox[{"CT1", ",", "CT2", ",", "CT3"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "ecf354e7-8c5d-4195-9585-3135058f8fab"],
 " and CT4, these variables are the Watts-Strogatz coefficient, the number of \
triangles that a node belongs to, the number of two step paths running \
through a node and the degree of a node respectively: "
}], "Text",
 CellChangeTimes->{{3.8195639673518286`*^9, 3.8195640050350404`*^9}, {
  3.819628464089299*^9, 3.8196284929381747`*^9}},
 FontSize->11,ExpressionUUID->"074f5b85-c5d5-4b43-807d-97658d43fcdc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CT1", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            SubscriptBox["WS", "2"], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "\[Equal]", "0"}], ",", 
         "Nothing", ",", 
         RowBox[{"Correlation", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["WS", "2"], "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"MT", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CT1", ",", "c"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "1000"}], "}"}]}], "]"}], ";", 
  RowBox[{"CT2", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            SubscriptBox["T", "2"], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "\[Equal]", "0"}], ",", 
         "Nothing", ",", 
         RowBox[{"Correlation", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["T", "2"], "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"MT", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CT2", ",", "c"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "1000"}], "}"}]}], "]"}], ";", 
  RowBox[{"CT3", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"Correlation", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["TS", "2"], "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"MT", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CT3", ",", "c"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "2", ",", "1000"}], "}"}]}], "]"}], ";", 
  RowBox[{"CT4", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"Correlation", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{"Total", ",", "NetworkEvolutionT"}], "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"MT", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CT4", ",", "c"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "2", ",", "1000"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8193788775492053`*^9, 3.81937898450505*^9}, {
   3.819379015269101*^9, 3.8193790354481125`*^9}, 3.8193790665808125`*^9, {
   3.819379099698208*^9, 3.8193791384116297`*^9}, 3.819382599709897*^9, {
   3.819474428142393*^9, 3.819474435852457*^9}},
 FontSize->11,
 CellLabel->
  "In[683]:=",ExpressionUUID->"7767e839-291d-4af2-832e-0db8a3ca3bf7"],

Cell["\<\
The list below now yields the mean value of each of the four lists generated \
above:\
\>", "Text",
 CellChangeTimes->{{3.8195640289630423`*^9, 3.8195640334041634`*^9}},
 FontSize->11,ExpressionUUID->"6c5d8f12-eb05-456a-9b22-0b0728093aa5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"List", "[", 
  RowBox[{
   RowBox[{"Mean", "[", "CT1", "]"}], ",", 
   RowBox[{"Mean", "[", "CT2", "]"}], ",", 
   RowBox[{"Mean", "[", "CT3", "]"}], ",", 
   RowBox[{"Mean", "[", "CT4", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8193793104952173`*^9, 3.8193793263458104`*^9}},
 FontSize->11,
 CellLabel->
  "In[684]:=",ExpressionUUID->"3ef0fad8-da80-4d53-9a38-5d0abe8e400f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.0482205521111027`", ",", "0.28955276303957855`", ",", 
   "0.7472203142369044`", ",", "0.6899862282161568`"}], "}"}]], "Output",
 CellChangeTimes->{3.8195248274708924`*^9},
 FontSize->11,
 CellLabel->
  "Out[684]=",ExpressionUUID->"a8c1be46-70e7-40e7-a127-81278a64ce37"]
}, Open  ]],

Cell["\<\
The following figure now yields a list plot of each of the four lists that we \
have produced:\
\>", "Text",
