 CellLabel->
  "In[888]:=",ExpressionUUID->"d7cdb55c-5ce7-4891-8d3d-10c582db08bc"],

Cell[TextData[{
 "The plot below shows how accurately the dynamical importances of the nodes \
in the network ",
 Cell[BoxData[
  FormBox["C2", TraditionalForm]],ExpressionUUID->
  "b67d5c8e-5dcb-4e75-bd9d-523191ee07f1"],
 " are represented by equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "5", ")"}], TraditionalForm]],ExpressionUUID->
  "69acdbac-eefd-499c-ae4b-33487295a9c4"],
 " from the paper by Restrepo, Ott and Hunt (2006):"
}], "Text",
 CellChangeTimes->{{3.8189540319241714`*^9, 3.818954036114008*^9}, {
  3.8195298374327946`*^9, 3.819529847954468*^9}, {3.819530042033087*^9, 
  3.819530042834429*^9}, {3.819627252467888*^9, 3.8196272610060215`*^9}, {
  3.819641622706868*^9, 3.819641628233102*^9}},
 FontSize->11,ExpressionUUID->"91a1e4e8-e544-4072-9a20-d6495d0cd38a"],

