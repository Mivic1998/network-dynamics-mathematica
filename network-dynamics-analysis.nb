 FontSize->11,ExpressionUUID->"72417f3d-ad97-4e1a-b7b1-87c0468a9e12"],

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"CS1", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<t\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(WS, \*SubscriptBox[\(I\), \(k\
\)]\)]\)\>\""}], "}"}]}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"CS2", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<t\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(Tr, \*SubscriptBox[\(I\), \(k\
\)]\)]\)\>\""}], "}"}]}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"CS3", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<t\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(TS, \*SubscriptBox[\(I\), \(k\
\)]\)]\)\>\""}], "}"}]}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"CS4", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<t\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(d, \*SubscriptBox[\(I\), \
\(k\)]\)]\)\>\""}], "}"}]}]}], "]"}]}], "}"}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.8193785517768135`*^9, 3.81937855832732*^9}, {
   3.8193786778365383`*^9, 3.8193786972894926`*^9}, {3.819621933970666*^9, 
   3.819622037132768*^9}, 3.8196221254285913`*^9},
 FontSize->11,
 CellLabel->
  "In[856]:=",ExpressionUUID->"f7f6a17d-44ba-43fa-badd-11e6998bcd43"],

