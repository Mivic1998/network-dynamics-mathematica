Cell[TextData[{
 "The command ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "[", "A", "]"}], TraditionalForm]],ExpressionUUID->
  "a7b6b6f4-dfa0-4806-b2b1-ccda5e0e4b08"],
 " below computes the third power of a given matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "779bc32f-3d87-44a4-ac9d-3a211029b24c"],
 ", the diagonal element ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "d2987a42-b24a-430d-89d2-f3682eadcc6b"],
 " of which yields the number of triangles that the node ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "bd20e902-ad00-4eb9-b5ce-ba6720b2fada"],
 " is a part of given that ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "1ad91e08-c6b4-4376-871f-baf4eef00e73"],
 " is an unweighted adjacency matrix:  "
}], "Text",
 CellChangeTimes->{{3.819366426105115*^9, 3.819366433698834*^9}, {
  3.8193664957906713`*^9, 3.8193665252628536`*^9}, {3.8193667887779264`*^9, 
  3.8193668474280095`*^9}},
 FontSize->11,ExpressionUUID->"29aa878d-4106-495c-94d8-88e0abf890e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", 
    RowBox[{"A_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"MatrixPower", "[", 
    RowBox[{"A", ",", "n"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"p", "[", "A_", "]"}], ":=", 
   RowBox[{"y", "[", 
    RowBox[{"A", ",", "3"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.8179146849603777`*^9, 3.817914690094248*^9}, {
  3.819120652671727*^9, 3.81912065573155*^9}},
 FontSize->11,
 CellLabel->
  "In[662]:=",ExpressionUUID->"a8c085ec-56d0-4684-a46c-3625e403a7f7"],

Cell[TextData[{
 "The command below now generates the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "Q", ".", "A"}], TraditionalForm]],ExpressionUUID->
  "e83fb4a1-4640-47af-be76-f339a4f886b5"],
 " (where ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "213a663e-c6ac-460e-892b-0155490a1984"],
 " has been defined in part ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "71aa49ab-d5cc-403d-85fd-c1a72a85f134"],
 "), the diagonal element ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "ddf02f51-f1c5-4b21-a262-b9d272251aa2"],
 " of which yields the number of two step paths running through the node ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "a9f9b83a-99da-452b-838c-deb1e0773739"],
 " given that ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "8f0ba4e9-b565-4847-b3a2-47daa38f700f"],
 " is an unweighted adjacency matrix: "
}], "Text",
 CellChangeTimes->{{3.8193664499862213`*^9, 3.8193664712782545`*^9}, {
  3.819366571998932*^9, 3.8193666028144903`*^9}, {3.8193667515246344`*^9, 
  3.8193667742538233`*^9}, {3.8193668604970427`*^9, 3.819366943823139*^9}},
 FontSize->11,ExpressionUUID->"9e086ec9-2da7-4eb6-baa6-284a100a2465"],

Cell[BoxData[
 RowBox[{
  RowBox[{"TwoStep", "[", "A_", "]"}], ":=", 
  RowBox[{"A", " ", ".", 
   RowBox[{"Q", "[", 
    RowBox[{"Length", "[", "A", "]"}], "]"}], ".", "A"}]}]], "Input",
 FontSize->11,
 CellLabel->
  "In[665]:=",ExpressionUUID->"1f8484ba-d3a3-42d9-b86a-54618293a952"],

Cell[TextData[{
 "Now, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", "1"], TraditionalForm]],ExpressionUUID->
  "1d332527-a88f-4c5b-b9ee-0b8e16ccfd24"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["TS", "1"], TraditionalForm]],ExpressionUUID->
  "5287b292-ac6a-485d-9390-e4149a96d4e4"],
 " below yield matrices for which the elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "f0962721-a500-454d-bec3-9ebc65d21072"],
 " yield the number of triangles that the node ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "61024d82-64ff-4ddc-aaf3-980d218a5465"],
 " is a member of and the number of two-step links going through node ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "554031fb-e582-4714-ab5b-57d6d3b5721b"],
 " respectively for the network corresponding to the adjacency matrix ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "0c05c35e-0774-4b6a-8628-678dd8824a88"],
 " of the list NetworkEvolutionS. Meanwhile, the command which yields ",
 Cell[BoxData[
  FormBox["WS1", TraditionalForm]],ExpressionUUID->
  "a756c5c1-a54f-42ed-bfbf-a3fcaa464ab2"],
 " below generates a matrix of which element ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "3f62fae1-39f2-4056-859d-ca4aee5bc79e"],
 " yields the Watts-Strogatz coefficient corresponding to node ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "b24822fd-db7d-4ff7-a712-7c5a13029d8f"],
 " for the network represented by the adjacency matrix ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "ab7917f0-2bec-4505-bca5-16b347664233"],
 " of NetworkEvolutionS. Finally, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["WS", "1"], TraditionalForm]],ExpressionUUID->
  "74d6460c-4738-44ce-b3f1-cd558eb4f7a2"],
 " replaces the readings for nodes with an indeterminate Watts-Strogatz \
coefficient (i.e. nodes with zero two step paths passing through them) with \
zero:"
}], "Text",
 CellChangeTimes->{{3.819367299383464*^9, 3.819367616915899*^9}, {
  3.8193676554467773`*^9, 3.8193676726437473`*^9}, {3.8193677053512783`*^9, 
  3.819367900764409*^9}, {3.8196281148134613`*^9, 3.8196281230623894`*^9}},
 FontSize->11,ExpressionUUID->"b72986c6-3690-434e-a39d-e539c69272f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["T", "1"], "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Diagonal", ",", 
     RowBox[{"Map", "[", 
      RowBox[{"p", ",", "NetworkEvolutionS"}], "]"}]}], "]"}]}], ";", 
  RowBox[{
   SubscriptBox["TS", "1"], "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Diagonal", ",", 
     RowBox[{"Map", "[", 
      RowBox[{"TwoStep", ",", "NetworkEvolutionS"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"WS1", "=", 
   FractionBox[
    SubscriptBox["T", "1"], 
    SubscriptBox["TS", "1"]]}], ";", 
  RowBox[{
   SubscriptBox["WS", "1"], "=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{"WS1", ",", 
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{"WS1", ",", "Indeterminate"}], "]"}], "\[Rule]", "0"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8181858463011007`*^9, 3.8181858467090125`*^9}, {
  3.8191207538652945`*^9, 3.8191207697146964`*^9}},
 FontSize->11,
 CellLabel->
  "In[667]:=",ExpressionUUID->"65e2fb97-d4cd-4a14-b3c6-e280b5103ae5"],

Cell[TextData[{
 "The command below generates a matrix ",
 Cell[BoxData[
  FormBox["MS", TraditionalForm]],ExpressionUUID->
  "11970149-e09b-4e73-9514-dea80147ee12"],
 ", where entry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "81e4ed32-9f07-49b6-89a6-616ee74deac5"],
 " of the matrix in question yields the dynamical importance of node ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "e924ad95-3fd5-4cd4-9a96-c1c800bb8539"],
 " of the network corresponding to the adjacency matrix ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "22409a3e-d08b-4b4e-8405-9051bb922b22"],
 " in NetworkEvolutionS:"
}], "Text",
 CellChangeTimes->{{3.819187765763452*^9, 3.8191878100092115`*^9}, 
   3.8195551145965242`*^9, {3.8195605385490403`*^9, 3.8195605488125887`*^9}, {
   3.819561243425494*^9, 3.8195612516667747`*^9}, {3.819561325529106*^9, 
   3.819561330949607*^9}, {3.819643264729517*^9, 3.819643265354844*^9}},
 FontSize->11,ExpressionUUID->"16a3daa7-5f8a-4e6d-82a3-747b856e2a6b"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"\[CapitalDelta]EvnS", "=", 
    RowBox[{"{", "}"}]}],
   FontWeight->"Bold"], 
  StyleBox[";",
   FontWeight->"Bold"], 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", "=", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", "[", 
          RowBox[{"NetworkEvolutionS", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"f", "[", 
       RowBox[{
        RowBox[{"NetworkEvolutionS", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\[Lambda]"}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "NetworkEvolutionS", "]"}]}], "}"}]}], "]"}], 
  ";", 
  RowBox[{"MS", "=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Re", "[", 
      StyleBox["\[CapitalDelta]EvnS",
       FontWeight->"Bold"], 
      StyleBox["]",
       FontWeight->"Bold"]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "NetworkEvolutionS", "]"}], ",", "400"}], 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.818155302627627*^9, 3.818155307653348*^9}, {
   3.8181831391346126`*^9, 3.8181831395584445`*^9}, 3.819120792376085*^9, {
   3.819474670753833*^9, 3.819474672872637*^9}},
 FontSize->11,
 CellLabel->
  "In[669]:=",ExpressionUUID->"a5dd2785-9dbc-4af8-ac84-fcbc00f4f860"],

Cell[TextData[{
 "The following set of commands now generates four lists, each of which has \
element ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d9f1b6d0-46ca-41db-9a81-4722711bca66"],
 " that yields the correlation of the dynamical importance of a node with \
some variable for the ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "60d3712c-df6f-4d10-93d7-6e64e11b7671"],
 "-th network in the list NetworkEvolutionS. For the lists ",
 Cell[BoxData[
  FormBox[
   RowBox[{"CS1", ",", "CS2", ",", "CS3"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "70bf4159-729d-4256-b717-87809684c972"],
 " and CS4, these variables are the Watts-Strogatz coefficient, the number of \
triangles that a node belongs to, the number of two step paths running \
through a node and the degree of a node respectively: "
}], "Text",
 CellChangeTimes->{{3.8195632763858476`*^9, 3.8195632863831096`*^9}, {
  3.8195634100543747`*^9, 3.819563726574812*^9}, {3.8196281576329317`*^9, 
  3.819628160680746*^9}},
 FontSize->11,ExpressionUUID->"af0dd6b2-aa21-40fc-82b7-c86a016d651c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CS1", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            SubscriptBox["WS", "1"], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "\[Equal]", "0"}], ",", 
         "Nothing", ",", 
         RowBox[{"Correlation", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["WS", "1"], "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"MS", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CS1", ",", "c"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "1000"}], "}"}]}], "]"}], ";", 
  RowBox[{"CS2", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            SubscriptBox["T", "1"], "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "\[Equal]", "0"}], ",", 
         "Nothing", ",", 
         RowBox[{"Correlation", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["T", "1"], "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"MS", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CS2", ",", "c"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "1000"}], "}"}]}], "]"}], ";", 
  RowBox[{"CS3", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"Correlation", "[", 
        RowBox[{
         RowBox[{
          SubscriptBox["TS", "1"], "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"MS", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CS3", ",", "c"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "1000"}], "}"}]}], "]"}], ";", 
  RowBox[{"CS4", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"Correlation", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{"Total", ",", "NetworkEvolutionS"}], "]"}], "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"-", 
          RowBox[{"MS", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"CS4", ",", "c"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "1000"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8191971454807034`*^9, 3.819197185941063*^9}, {
   3.8191972364464474`*^9, 3.819197399569245*^9}, {3.819198083161599*^9, 
   3.8191980999944487`*^9}, {3.8193742573322563`*^9, 3.819374271993993*^9}, {
   3.819374339401641*^9, 3.8193744254524145`*^9}, {3.8193759040703545`*^9, 
   3.819375904202999*^9}, {3.8193785641786313`*^9, 3.819378564479828*^9}, {
   3.8193786349582615`*^9, 3.819378673361548*^9}, {3.8193791726450405`*^9, 
   3.819379191068745*^9}, 3.819380912164937*^9, {3.8194743817283335`*^9, 
   3.819474391300892*^9}, 3.8194836491545243`*^9},
 FontSize->11,
 CellLabel->
  "In[686]:=",ExpressionUUID->"d7aee3b4-9b37-465b-8e34-23308d33dd38"],

Cell["\<\
The list below now yields the mean value of each of the four lists generated \
above:\
\>", "Text",
 CellChangeTimes->{{3.8195637307336884`*^9, 3.819563824042125*^9}},
 FontSize->11,ExpressionUUID->"ffb9f8ba-33c0-49c6-8892-c9cb8611cb11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"List", "[", 
  RowBox[{
   RowBox[{"Mean", "[", "CS1", "]"}], ",", 
   RowBox[{"Mean", "[", "CS2", "]"}], ",", 
   RowBox[{"Mean", "[", "CS3", "]"}], ",", 
   RowBox[{"Mean", "[", "CS4", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.819374508317705*^9, 3.819374513959611*^9}, {
  3.8193784994787736`*^9, 3.819378526377768*^9}},
 FontSize->11,
 CellLabel->
  "In[687]:=",ExpressionUUID->"f534f2f3-9fa2-44f7-ac40-7a0513590fe5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.1337759442438317`", ",", "0.4030850842627857`", ",", 
   "0.7516281039706624`", ",", "0.6739356275034026`"}], "}"}]], "Output",
 CellChangeTimes->{3.8193785296380453`*^9, 3.8193825159739337`*^9, 
  3.819526550296713*^9},
 FontSize->11,
 CellLabel->
  "Out[687]=",ExpressionUUID->"8b0cb70a-e075-44c9-90a9-076cfa250545"]
}, Open  ]],

