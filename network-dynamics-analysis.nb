Cell[TextData[{
 "Thus, we see that in general the networks in SampleA have a greater Newman \
clustering coefficient than the networks in SampleB. Note that the links in a \
SampleB network are expected to be a subset of the links that exist in a \
SampleA network, since the probability that a given link exists in SampleA is \
at least as large as the probability that the corresponding link exists in ",
 Cell[BoxData[
  FormBox["SampleB", TraditionalForm]],ExpressionUUID->
  "a4b5614f-4f52-41f2-9ba9-15986c0a2d8e"],
 ", so the fact that nodes in this network exhibit a lower propensity to \
cluster is no surprise. Now, the following command computes the numerical \
value of the largest eigenvalue in absolute value of a matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "30082b52-2a41-4010-898b-c744680da55e"],
 ":"
}], "Text",
 CellChangeTimes->{{3.819366206494685*^9, 3.8193662641234994`*^9}, {
  3.8195534654397583`*^9, 3.819553626739256*^9}, {3.8195538346588078`*^9, 
  3.819553932507082*^9}, {3.8195541450918727`*^9, 3.8195541827064557`*^9}, {
  3.8195545500766144`*^9, 3.819554550608515*^9}, {3.8196247192502203`*^9, 
  3.819624719622226*^9}},
 FontSize->11,ExpressionUUID->"827bd588-3106-47be-a7c4-392fb34a7b15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EvA", "[", "A_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Eigenvalues", "[", 
    RowBox[{"N", "[", "A", "]"}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.81790277583033*^9, 3.817902797937218*^9}, {
  3.8182530679650593`*^9, 3.818253070802476*^9}, {3.818323718418403*^9, 
  3.8183237209895306`*^9}, {3.8193662000589037`*^9, 3.8193662024096155`*^9}},
 FontSize->11,
 CellLabel->"In[12]:=",ExpressionUUID->"f918f92b-8696-4512-a70f-b0100b7a7352"],

Cell["\<\
The following commands calculate the largest eigenvalue for every network in \
SampleA and SampleB respectively:\
\>", "Text",
 CellChangeTimes->{{3.819554191548315*^9, 3.819554216796756*^9}, {
  3.8196247464505043`*^9, 3.8196247486396513`*^9}, {3.819638248463318*^9, 
  3.8196382501817226`*^9}},
 FontSize->11,ExpressionUUID->"6bd59a4e-f419-43b3-a8d6-161884330378"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Ev1", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"EvA", ",", "SampleA"}], "]"}], "]"}]}], ";", 
  RowBox[{"Ev2", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"Map", "[", 
     RowBox[{"EvA", ",", "SampleB"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8179028117768307`*^9, 3.8179028232023525`*^9}, 
   3.8179030479485955`*^9, {3.8179030972304153`*^9, 3.817903102408828*^9}, 
   3.8190979609588175`*^9, {3.819387635091386*^9, 3.8193876433568616`*^9}, {
   3.819387814810961*^9, 3.8193878309189806`*^9}, {3.8193881223717566`*^9, 
   3.819388145107849*^9}},
 FontSize->11,
 CellLabel->"In[38]:=",ExpressionUUID->"27691746-f16e-43b0-b5e7-23558caf48ad"],

Cell["\<\
Below are the distributions for the largest eigenvalue across SampleA \
(leftmost figure) and SampleB (rightmost figure):\
