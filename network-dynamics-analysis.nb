   3.8036305600929832`*^9, 3.8036305600929832`*^9}, {3.8036307783781133`*^9, 
   3.8036308606011815`*^9}, {3.8053681946307354`*^9, 
   3.8053682120110083`*^9}, {3.8053682718437815`*^9, 
   3.8053683269435396`*^9}, {3.8053683619824047`*^9, 3.805368707126303*^9}, {
   3.80536876819514*^9, 3.8053688654388213`*^9}, {3.805368933520688*^9, 
   3.805368980534671*^9}, {3.8053690139001265`*^9, 3.8053691639045515`*^9}, {
   3.8053692441480365`*^9, 3.80536931864217*^9}, {3.8168635272309895`*^9, 
   3.8168635845935636`*^9}, {3.816863685372053*^9, 3.81686375134494*^9}, {
   3.81686388120994*^9, 3.816863947167095*^9}, {3.816863997606894*^9, 
   3.816864003864453*^9}, {3.8168640429415116`*^9, 3.8168641026916676`*^9}, {
   3.816864152463027*^9, 3.8168641981214075`*^9}, {3.816864244975381*^9, 
   3.816864375626174*^9}, {3.8168651879418955`*^9, 3.8168652172367887`*^9}, {
   3.816865338989642*^9, 3.816865387944996*^9}, 3.8168657702389717`*^9, {
   3.816866419994608*^9, 3.8168664302128572`*^9}, {3.9987359248725376`*^9, 
   3.998735925821684*^9}, {3.998736162059372*^9, 3.99873617186977*^9}, {
   3.9987400563126984`*^9, 3.99874005864752*^9}},
 TextJustification->0.,
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"3f1e9cf7-7e19-431b-9086-21c22d9dfead"],

Cell[TextData[{
 "The Do command below takes row and column ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "3c825c22-2430-405f-b433-65a5eec1fb65"],
 " of a specified adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "864fef80-f243-43b6-9553-d99740a5e2a9"],
 " and sets all of their components to ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "9102cbed-0127-4e5f-a430-a2a7236f6117"],
 " (which represents the removal of all incoming and outgoing links \
corresponding to node ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "d859ed1f-ca79-423b-b016-7bd7a8dad0b3"],
 " of the network described by ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "c37f638b-f7b0-4afa-8e0d-177f9abd1452"],
 "). The command then calculates the relative change in the largest \
eigenvalue with respect to the original adjacency matrix for this new \
adjacency matrix ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "4cf47545-d8f9-41f7-a867-7f5205b2df91"],
 ", and appends the result to the list \[CapitalDelta]Evn. It does this for \
all rows and columns of the original adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "aa526aae-720e-4eaf-8d2b-ecd0b9a7b5e5"],
 ". Note that element ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]],ExpressionUUID->
  "eba3fef1-8b75-49df-8b21-9e98f51b113c"],
 " of the list \[CapitalDelta]Evn corresponds to the relative change in the \
value of the largest eigenvalue when we add/remove the node ",
 Cell[BoxData[
  FormBox["l", TraditionalForm]],ExpressionUUID->
  "94fb46ac-5248-46ac-95b6-c88f570ac36c"],
 " from the network represented by the original adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "0060314c-e889-4d69-9de4-6d9d41147a20"],
 ". Again, in order to maximise the speed of the calculation described, we \
have written the function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "6976c3cb-cbe2-40ac-afe1-baa070155f8c"],
 " below so that value of the largest eigenvalue of the original matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "366ed22b-d5c7-4b2e-b6cd-cf990f3b7f1f"],
 " is specified as an initial input."
}], "Text",
 CellChangeTimes->{{3.819288908930046*^9, 3.819288912030781*^9}, {
  3.819289034730468*^9, 3.819289043040268*^9}, {3.819289189349781*^9, 
  3.819289403340246*^9}, {3.8192894445549755`*^9, 3.819289454699834*^9}, {
  3.8192894947805963`*^9, 3.8192894968929462`*^9}, {3.819289603731098*^9, 
  3.819289610808163*^9}, {3.819289767146915*^9, 3.8192898034886456`*^9}, {
  3.819289834058854*^9, 3.8192898786096582`*^9}, {3.819625914776673*^9, 
  3.8196259393619013`*^9}, {3.819639565157754*^9, 3.81963956580204*^9}},
 FontSize->11,ExpressionUUID->"d03136ca-80c3-4ba0-9173-5c29d597bb98"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"A_", ",", "\[Lambda]_"}], "]"}], ":=", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"B", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"ReplacePart", "[", 
            RowBox[{"A", ",", 
             RowBox[{"k", "\[Rule]", 
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"Length", "[", "A", "]"}]}], "]"}]}]}], "]"}], "]"}], 
          ",", 
          RowBox[{"k", "\[Rule]", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"Length", "[", "A", "]"}]}], "]"}]}]}], "]"}], "]"}]}], 
      ",", 
      RowBox[{"\[Mu]", "=", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", "B", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{
        StyleBox["\[CapitalDelta]Evn3",
         FontWeight->"Bold"], ",", 
        FractionBox[
         RowBox[{"\[Mu]", "-", "\[Lambda]"}], "\[Lambda]"]}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "200"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.817502957043394*^9, 3.817502998287901*^9}, {
   3.8175033754793677`*^9, 3.817503400819253*^9}, {3.817503512235074*^9, 
   3.817503520190297*^9}, {3.8175035618616076`*^9, 3.817503611915631*^9}, {
   3.8175036605769815`*^9, 3.817503666264739*^9}, {3.817503804301419*^9, 
   3.817503839520997*^9}, {3.8175038757040434`*^9, 3.8175038872996645`*^9}, {
   3.817503939893197*^9, 3.8175039420125327`*^9}, {3.8175041529251385`*^9, 
   3.817504223768687*^9}, {3.817504309845401*^9, 3.817504410516452*^9}, {
   3.817506114026471*^9, 3.817506120598812*^9}, 3.8177349751366205`*^9, {
   3.817735133163214*^9, 3.8177351332709255`*^9}, 3.8177353024357862`*^9, 
   3.8177664660241475`*^9, {3.817979759843398*^9, 3.817979759965108*^9}, {
   3.8179799128811884`*^9, 3.8179799129509964`*^9}, {3.8181553366604834`*^9, 
   3.818155337315734*^9}, {3.818155428354561*^9, 3.818155430814001*^9}, {
   3.8181618009020414`*^9, 3.8181618105205593`*^9}, {3.8181619957466836`*^9, 
   3.81816199583644*^9}, {3.818189858695895*^9, 3.818189870730551*^9}, {
   3.818200211192374*^9, 3.8182002118396435`*^9}, {3.8184128830241866`*^9, 
   3.818412889064042*^9}, 3.8184360374983406`*^9, 3.818437586973081*^9, {
   3.818438942493623*^9, 3.818438950435367*^9}, {3.818594892785742*^9, 
   3.818594897908062*^9}, {3.8185988184921246`*^9, 3.8185988257208033`*^9}, {
   3.8187518613968697`*^9, 3.818751861764885*^9}, {3.8187531250496674`*^9, 
   3.818753125591219*^9}, {3.8187607401232457`*^9, 3.818760740693721*^9}, {
   3.8190097194088893`*^9, 3.819009719840831*^9}, {3.819010947061265*^9, 
   3.819010947377223*^9}, {3.819016339783781*^9, 3.8190163404316993`*^9}, {
   3.8190174374647818`*^9, 3.819017437865423*^9}, {3.8190179959849586`*^9, 
   3.8190179963232746`*^9}, {3.8190191129310017`*^9, 
   3.8190191133154535`*^9}, {3.8190196041820827`*^9, 
   3.8190196116937227`*^9}, {3.819038748808397*^9, 3.8190387510489035`*^9}, {
   3.819058166277929*^9, 3.819058188041793*^9}, 3.8191230051090117`*^9, {
   3.8191331643794155`*^9, 3.8191331649538774`*^9}, {3.8192094062640715`*^9, 
   3.8192094093199253`*^9}, {3.8192094600962143`*^9, 3.819209460196912*^9}, {
   3.819385168317991*^9, 3.8193851686336045`*^9}, {3.819392066708412*^9, 
   3.819392067024789*^9}, {3.819392178330676*^9, 3.819392178646824*^9}, {
   3.8193939506489887`*^9, 3.8193939512809677`*^9}, {3.8194361594765253`*^9, 
   3.819436159570456*^9}, {3.8194376194442253`*^9, 3.819437619529049*^9}, {
   3.8194657678473854`*^9, 3.8194657681788597`*^9}, {3.8194674528176403`*^9, 
   3.819467453080411*^9}, {3.8194682415113816`*^9, 3.819468242165184*^9}, {
   3.8194687317524033`*^9, 3.819468732653694*^9}, {3.8194700299133563`*^9, 
   3.81947003061408*^9}, {3.8194712981586094`*^9, 3.8194712985126452`*^9}, {
   3.8194720166163816`*^9, 3.8194720170012817`*^9}, {3.8194725109908576`*^9, 
   3.8194725114071608`*^9}, {3.819473377517867*^9, 3.8194733780875263`*^9}, {
   3.819474645648421*^9, 3.8194746459423947`*^9}, {3.8194835552666545`*^9, 
   3.8194835553292823`*^9}, {3.819483664196587*^9, 3.8194836663862715`*^9}, {
   3.8195581752599072`*^9, 3.8195581753197546`*^9}, {3.819559663087485*^9, 
   3.819559664577508*^9}, {3.8195602383403482`*^9, 3.819560241114891*^9}, {
   3.8195603743355775`*^9, 3.8195603759961367`*^9}, {3.8195649557194448`*^9, 
   3.819564957812832*^9}},
 FontSize->11,
 CellLabel->
