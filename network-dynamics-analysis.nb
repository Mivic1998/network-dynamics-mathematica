Cell["\<\
The plot above shows that, for a given row in the square lattice, the more \
central a node is with respect to its position in that particular row, the \
higher is its dynamical importance. Similarly, for a given column in the \
square lattice, the more central a node is with respect to its position in \
that particular column, the higher is its dynamical importance. As a result, \
the four most central nodes in the lattice have the highest dynamical \
importance, while the nodes on the corners of the lattice have the lowest \
dynamical importance.
\
\>", "Text",
 CellChangeTimes->{{3.8196205445609183`*^9, 3.819620589007083*^9}, {
   3.8196207358054533`*^9, 3.819620738588015*^9}, {3.819620816135562*^9, 
   3.8196208910551853`*^9}, {3.819620924486769*^9, 3.8196209562917004`*^9}, 
   3.998736935217699*^9},
 FontSize->11,ExpressionUUID->"68945c93-4a84-4fde-8f5e-7a41021bff36"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "        ",
 StyleBox["Network Evolution Simulation",
  FontSize->20,
  FontColor->RGBColor[0.5019607843137255, 0., 0.]]
}], "Subtitle",
 CellChangeTimes->{{3.9987365406531467`*^9, 3.9987365571655807`*^9}, 
   3.9987367417080345`*^9, {3.9987369298094044`*^9, 
   3.998736933362318*^9}},ExpressionUUID->"bd3cdf20-155f-6946-a778-\
34cf0d8d9e7a"],

Cell["\<\
I implement an iterative network-evolution algorithm. At each time step, a \
node is selected at random and its existing connections are removed. It is \
then reconnected symmetrically to four nodes, with the probability of \
selecting a target node weighted by its degree. Each resulting adjacency \
matrix is stored so that the evolution of the network can be analysed over \
time.\
\>", "Text",
 CellChangeTimes->{{3.598452093952716*^9, 3.598452204485716*^9}, {
   3.652420633161273*^9, 3.6524206868278103`*^9}, {3.652420752564468*^9, 
   3.6524207756666994`*^9}, {3.6524208270572195`*^9, 3.652420860190551*^9}, {
   3.6524210786297*^9, 3.6524210940307*^9}, {3.652967960434185*^9, 
   3.652968115298876*^9}, {3.6529733486104965`*^9, 3.6529733896518383`*^9}, {
   3.683718120594956*^9, 3.683718123730938*^9}, {3.6837181586916018`*^9, 
   3.683718175369363*^9}, {3.6837741655485477`*^9, 3.683774166986993*^9}, {
   3.683774748963084*^9, 3.683774773993095*^9}, {3.683774831383595*^9, 
   3.68377486405478*^9}, {3.683774918249523*^9, 3.683774954160534*^9}, {
   3.6845117734469385`*^9, 3.684511835768572*^9}, 3.6845119826187377`*^9, {
   3.6846037549010444`*^9, 3.6846038176765676`*^9}, {3.6851288323337092`*^9, 
   3.6851291036115475`*^9}, {3.6851297173722887`*^9, 3.685129718458522*^9}, {
   3.6851314218370667`*^9, 3.685131447867895*^9}, {3.685131509731413*^9, 
   3.685131517663705*^9}, {3.685185089630221*^9, 3.6851852810272207`*^9}, {
   3.697183568757872*^9, 3.697183594886485*^9}, {3.7472105780738697`*^9, 
   3.7472105832291517`*^9}, {3.753013281511385*^9, 3.7530133238314266`*^9}, {
   3.753013729293499*^9, 3.7530137773346033`*^9}, {3.753013815932062*^9, 
   3.7530139762751236`*^9}, {3.753014067140837*^9, 3.753014068139863*^9}, {
   3.753014114597804*^9, 3.7530142710179152`*^9}, {3.7530144253634095`*^9, 
   3.753014429107126*^9}, {3.7530147773772297`*^9, 3.7530147774645844`*^9}, {
   3.755154789567511*^9, 3.755154859269661*^9}, {3.7680401569374084`*^9, 
   3.768040157385848*^9}, {3.7680402358806114`*^9, 3.7680402373383317`*^9}, {
   3.77495920130507*^9, 3.7749597620291457`*^9}, {3.77513286750156*^9, 
   3.775132898021247*^9}, {3.778866087425239*^9, 3.778866259527502*^9}, {
   3.778866295466211*^9, 3.7788664058104787`*^9}, {3.8014866697031603`*^9, 
   3.8014866716380296`*^9}, {3.801486916405057*^9, 3.801486975596875*^9}, {
   3.801487017370192*^9, 3.801487047063816*^9}, {3.8014871633479366`*^9, 
   3.801487181410654*^9}, {3.801487215713957*^9, 3.80148721859031*^9}, {
   3.8014877143143015`*^9, 3.8014880032888165`*^9}, {3.8014882268073134`*^9, 
   3.8014882413764153`*^9}, {3.8033793583540897`*^9, 
   3.8033794273583603`*^9}, {3.8033796228154287`*^9, 3.803379640089072*^9}, {
   3.8033805615415697`*^9, 3.803380646874024*^9}, {3.803630406717191*^9, 
   3.8036304192536693`*^9}, {3.803630518297773*^9, 3.803630518609902*^9}, {
   3.8036305600929832`*^9, 3.8036305600929832`*^9}, {3.8036307783781133`*^9, 
   3.8036308606011815`*^9}, {3.8053681946307354`*^9, 
   3.8053682120110083`*^9}, {3.8053682718437815`*^9, 
   3.8053683269435396`*^9}, {3.8053683619824047`*^9, 3.805368707126303*^9}, {
   3.80536876819514*^9, 3.8053688654388213`*^9}, {3.805368933520688*^9, 
   3.805368980534671*^9}, {3.8053690139001265`*^9, 3.8053691639045515`*^9}, {
   3.8053692441480365`*^9, 3.80536931864217*^9}, {3.8168635272309895`*^9, 
   3.8168635845935636`*^9}, {3.816863685372053*^9, 3.81686375134494*^9}, {
   3.81686388120994*^9, 3.816863947167095*^9}, {3.816863997606894*^9, 
   3.816864003864453*^9}, {3.8168640429415116`*^9, 3.8168641026916676`*^9}, {
   3.816864152463027*^9, 3.8168641981214075`*^9}, {3.816864244975381*^9, 
   3.816864375626174*^9}, 3.81686440976361*^9, {3.816864534843068*^9, 
   3.8168645594550934`*^9}, {3.8168646203941975`*^9, 3.816864674764329*^9}, {
   3.816864709158738*^9, 3.8168647804797378`*^9}, {3.8168648477534533`*^9, 
   3.8168648701486907`*^9}, 3.8168651661083965`*^9, {3.8168666981852508`*^9, 
   3.8168668560309324`*^9}, {3.998736521422451*^9, 3.998736533354452*^9}, {
   3.9987448350740776`*^9, 3.9987448374051704`*^9}},
 TextJustification->0.,
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"92c8e895-92ae-4a0c-8429-c8e3ba7af311"],

Cell[TextData[{
 "We will evolve the network so that the probability that a node ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "6b2af4d4-f8ba-4498-b602-6231d2343b7f"],
 " in the network is selected for reconnection with the randomly selected \
node whose connections have been removed at any time step is given by ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["d", "k"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], "n"], 
     SuperscriptBox["d", "k"]}]], TraditionalForm]],ExpressionUUID->
  "afd257a4-5010-49dd-9bb2-c553e91721a4"],
 ", where ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["d", "k"], TraditionalForm]],ExpressionUUID->
  "ac3d2c40-3e80-4497-b274-2cd7004376e2"],
 " is the degree of node ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "aefebf2e-219e-48d2-9947-8394d5e7aa26"],
 ". Now, the For command below first takes a network consisting of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "afb3b95e-d5d0-44e1-a114-591739a43fdb"],
 " nodes ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "993bbdfd-8530-4f9b-a2c2-344336ffbe9c"],
 ", which it labels ",
 Cell[BoxData[
  FormBox["N1", TraditionalForm]],ExpressionUUID->
  "60abc2c6-db56-43e7-8b7d-70e72452937d"],
 ", and appends it to the empty list NetworkEvolution. It then generates a \
random integer ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "f11aee70-0e8d-4470-a864-cb6dffd4e0c9"],
 " on the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"1", ",", "n"}], "]"}], TraditionalForm]],ExpressionUUID->
  "c552328a-9a67-4027-a5a4-6b60e90166d4"],
 " and removes all of the connections of the node with label ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "0d9ce196-388e-4755-b1d9-54d562193dce"],
 " from the network, which results in a new network labelled ",
 Cell[BoxData[
  FormBox["N2", TraditionalForm]],ExpressionUUID->
  "971c0284-292f-4363-8b95-8c01c5a2ede3"],
 ". It then calculates a list DegList, where each node\[CloseCurlyQuote]s \
label is repeated as many times as the in-degree of that node (note due to \
symmetry that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SuperscriptBox["d", "k"], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", "1"}], "n"], 
      SuperscriptBox["d", "k"]}]], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"2", 
       SuperscriptBox[
        SubscriptBox["d", "in"], "k"]}], 
      RowBox[{"2", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"k", "=", "1"}], "n"], 
        SuperscriptBox[
         SubscriptBox["d", "in"], "k"]}]}]], "=", 
     FractionBox[
      SuperscriptBox[
       SubscriptBox["d", "in"], "k"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"k", "=", "1"}], "n"], 
       SuperscriptBox[
        SubscriptBox["d", "in"], "k"]}]]}]}], TraditionalForm]],
  ExpressionUUID->"3e58baef-6b84-473d-ab1b-616bdd1fbf84"],
 ", so that selecting a node ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "ea83372f-8a5f-49b3-a87c-d79c0d46fcc8"],
 " for reconnection with probability equal to its relative frequency in \
DegList is equivalent to selecting that node for reconnection with \
probability ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["d", "k"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], "n"], 
     SuperscriptBox["d", "k"]}]], TraditionalForm]],ExpressionUUID->
  "e461e79a-8894-4afc-8d6c-c4d3cdfc35cf"],
 "). The command then enters a sub-loop where it sets the list ",
 Cell[BoxData[
  FormBox["DL", TraditionalForm]],ExpressionUUID->
  "4ca70aae-3edd-4ded-821d-bab0e180d9dd"],
 " to be equal to DegList and randomly selects a node ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "5ec160b5-f31c-4ade-a19c-38bdda8e07cc"],
 " from ",
 Cell[BoxData[
  FormBox["DL", TraditionalForm]],ExpressionUUID->
  "b1b7b02d-58d1-492d-b18b-cad827a21ce9"],
 ", after which it appends it to an initially empty list called \
ReconnectList. It then removes all entries ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "bd3be171-fd5e-4648-b30d-d33db77bc707"],
 " from ",
 Cell[BoxData[
  FormBox["DL", TraditionalForm]],ExpressionUUID->
  "3798d28b-61cf-4538-a9bb-3a402273bc71"],
 " and repeats this process ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "593e7f8b-bd1a-4a87-9ca6-2bb75f3f4be8"],
 " times. Returning to the first loop, Mathematica now creates a network ",
 Cell[BoxData[
  FormBox["N3", TraditionalForm]],ExpressionUUID->
  "8f6af9fa-c83d-4105-bfe8-cc06adb0474e"],
 " which symmetrically reconnects the node ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "6e52a9e8-9c61-4189-a2f6-978f741500f2"],
 " to the ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "407654ef-3eac-412d-8e89-cbdfba222fb1"],
 " nodes whose labels appear in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"ReconnectList", ".", " "}], TraditionalForm]],ExpressionUUID->
  "0747c093-b69d-4f10-bbbe-71bbede57af6"],
 "The command then appends ",
 Cell[BoxData[
  FormBox["N3", TraditionalForm]],ExpressionUUID->
  "e4ebfafb-7deb-4192-9195-f80702a7be20"],
 " to the list NetworkEvolution. The process described above is repeated ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]],ExpressionUUID->
  "ac079644-903b-44a3-8299-b9127981952d"],
 " times, and the end result is the list NetworkEvolution, whose entry ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "5a1b3af3-fbf8-43c1-a1e5-45ea1a206cd5"],
 " is given by the adjacency matrix corresponding to the evolved network at \
time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "i"}], TraditionalForm]],ExpressionUUID->
  "c018ada3-1e26-4092-9685-c6c4391dbf58"],
 ". The command ",
 Cell[BoxData[
  FormBox["F", TraditionalForm]],ExpressionUUID->
  "cac5a520-d594-4067-b803-d9da2bf141b6"],
 " in question is given below:"
}], "Text",
 CellChangeTimes->{{3.81930573384886*^9, 3.8193057398528004`*^9}, {
  3.8193593939663506`*^9, 3.8193594803442817`*^9}, {3.819359618289173*^9, 
  3.819359619534876*^9}, {3.8193600726694746`*^9, 3.819360155520805*^9}, {
  3.819360190823353*^9, 3.819360233266796*^9}, {3.8193602984294524`*^9, 
  3.819360298959036*^9}, {3.8193604053932676`*^9, 3.8193604060236197`*^9}, {
  3.8193604565075493`*^9, 3.8193605159096165`*^9}, {3.8193606954103603`*^9, 
  3.819360891531601*^9}, {3.8193609572068853`*^9, 3.8193609771176505`*^9}, {
  3.8193610286228256`*^9, 3.8193610620025053`*^9}, {3.819361212443036*^9, 
  3.8193615823882084`*^9}, {3.819362236365465*^9, 3.81936238566206*^9}, {
  3.8193625537254004`*^9, 3.8193626292064505`*^9}, {3.8193626800503817`*^9, 
  3.819363162589344*^9}, {3.8196279460707417`*^9, 3.8196279468955717`*^9}, {
  3.819642295161352*^9, 3.81964233516632*^9}},
 FontSize->11,ExpressionUUID->"cb8e5971-0b3e-4927-a760-2e6ac6f72b38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"T_", ",", "m_", ",", "A_"}], "]"}], ":=", 
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"t", "=", "2"}], ";", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N1", "=", "A"}], ",", 
       RowBox[{"NetworkEvolution", "=", 
        RowBox[{"{", "N1", "}"}]}]}], "}"}]}], ",", 
    RowBox[{"t", "\[LessSlantEqual]", "T"}], ",", 
    RowBox[{"t", "++"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Q", "=", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"Length", "[", "N1", "]"}]}], "}"}], "]"}]}], ",", 
      RowBox[{"N2", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"ReplacePart", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"ReplacePart", "[", 
            RowBox[{"N1", ",", 
             RowBox[{"Q", "\[Rule]", 
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"Length", "[", "N1", "]"}]}], "]"}]}]}], "]"}], "]"}],
           ",", 
          RowBox[{"Q", "\[Rule]", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"Length", "[", "N1", "]"}]}], "]"}]}]}], "]"}], "]"}]}], 
      ",", 
      RowBox[{"HalfDeg", "=", 
       RowBox[{"Total", "[", "N2", "]"}]}], ",", 
      RowBox[{"DegList", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{"j", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"HalfDeg", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"Length", "[", "HalfDeg", "]"}]}], "}"}]}], "]"}], 
        "]"}]}], ",", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"i", "=", "1"}], ";", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"DL", "=", "DegList"}], ",", 
           RowBox[{"ReconnectList", "=", 
            RowBox[{"{", "}"}]}]}], "}"}]}], ",", 
        RowBox[{"i", "\[LessSlantEqual]", "m"}], ",", 
        RowBox[{"i", "++"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"RC", "[", "i", "]"}], "=", 
           RowBox[{"RandomChoice", "[", "DL", "]"}]}], ",", 
          RowBox[{"DL", "=", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{"DL", ",", 
             RowBox[{"RC", "[", "i", "]"}]}], "]"}]}], ",", 
          RowBox[{"ReconnectList", "=", 
           RowBox[{"Append", "[", 
            RowBox[{"ReconnectList", ",", 
             RowBox[{"RC", "[", "i", "]"}]}], "]"}]}]}], "}"}]}], "]"}], ",", 
      RowBox[{"N3", "=", 
       RowBox[{"N2", "+", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"ReconnectList", ",", "i"}], "]"}], "&&", 
             RowBox[{"j", "\[Equal]", "Q"}]}], ",", "1", ",", "0"}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"Length", "[", "N2", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "N2", "]"}]}], "}"}]}], "]"}], "+", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{"ReconnectList", ",", "i"}], "]"}], "&&", 
              RowBox[{"j", "\[Equal]", "Q"}]}], ",", "1", ",", "0"}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "[", "N2", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "N2", "]"}]}], "}"}]}], "]"}], "]"}]}]}], 
      ",", 
      RowBox[{"NetworkEvolution", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"NetworkEvolution", ",", "N3"}], "]"}]}], ",", 
      RowBox[{"N1", "=", "N3"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8181529315580177`*^9, 3.818152936549674*^9}, {
  3.818182887521924*^9, 3.8181828940554237`*^9}, {3.8181843472045903`*^9, 
  3.8181843542607627`*^9}, {3.818188542782859*^9, 3.8181885708294163`*^9}, {
  3.818430053342222*^9, 3.81843005867297*^9}, {3.818436060034741*^9, 
  3.8184360665862284`*^9}, {3.8191027392487698`*^9, 3.8191027450173388`*^9}, {
  3.819105236445141*^9, 3.819105243869438*^9}, {3.8194736223829308`*^9, 
  3.819473626759062*^9}, {3.819474079788658*^9, 3.819474087422179*^9}, {
  3.8196279978921394`*^9, 3.819628002792034*^9}},
 FontSize->11,
 CellLabel->
  "In[867]:=",ExpressionUUID->"3376b575-515b-43d7-a0a2-9b1dcc57a0d7"],

Cell[TextData[{
 "In our case, we want to apply the command above to the network described by \
the adjacency matrix ",
 Cell[BoxData[
  FormBox["B1", TraditionalForm]],ExpressionUUID->
  "6cd81f8a-4580-4fc0-888c-7bfd15bdb058"],
 ", and since we want four reconnections at every iteration of the network\
\[CloseCurlyQuote]s evolution, we set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "4"}], TraditionalForm]],ExpressionUUID->
  "6c1c7c20-f174-4736-b5e2-258f961bbd2a"],
 ". Finally, we set the number of time steps for which the network\
\[CloseCurlyQuote]s evolution occurs to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "=", "1000"}], TraditionalForm]],ExpressionUUID->
  "c54169f2-3602-4e91-821f-aefe72d881e7"],
 ":"
}], "Text",
 CellChangeTimes->{{3.8193631672179594`*^9, 3.81936332650379*^9}, {
  3.819363669000436*^9, 3.819363669244819*^9}},
 FontSize->11,ExpressionUUID->"31fd0519-6824-4b17-a176-7fffa8dbbf64"],

Cell[BoxData[
 RowBox[{"F", "[", 
  RowBox[{"1000", ",", "4", ",", "B1"}], "]"}]], "Input",
 CellChangeTimes->{{3.817765730806384*^9, 3.8177657519359045`*^9}, {
  3.8181529602014227`*^9, 3.8181529628802977`*^9}, {3.8181532811746964`*^9, 
  3.8181532815945377`*^9}, {3.8181533686307535`*^9, 3.81815336927806*^9}, {
  3.818154069329643*^9, 3.818154070754862*^9}, {3.818159539876808*^9, 
  3.818159541274044*^9}},
 FontSize->11,
 CellLabel->
  "In[658]:=",ExpressionUUID->"cb48bf88-e313-43ae-affd-e6a9ef782833"],

Cell["\<\
We call the resultant list NetworkEvolutionS in the case of the square lattice.
\
\>", "Text",
 CellChangeTimes->{{3.8196280778692417`*^9, 3.819628100117759*^9}, 
   3.998736920159956*^9},
 FontSize->11,ExpressionUUID->"fa7157ce-b352-4fb1-8293-dba259732de2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "        ",
 StyleBox["Evolution Analysis",
  FontSize->20,
  FontColor->RGBColor[0.5019607843137255, 0., 0.]]
}], "Subtitle",
 CellChangeTimes->{{3.9987365950389843`*^9, 3.998736614137081*^9}, {
  3.9987369145528946`*^9, 
  3.99873691837315*^9}},ExpressionUUID->"eee64818-1b21-7f42-9129-\
216fb9df91e2"],

Cell["\<\
I analyse how the evolution process affects node dynamical importance and \
local network structure. I compare dynamical importance with the \
Watts\[Dash]Strogatz clustering coefficient and also examine its relationship \
with triangle participation, two-step paths and node degree as the network \
evolves.\
\>", "Text",
 CellChangeTimes->{{3.598452093952716*^9, 3.598452204485716*^9}, {
   3.652420633161273*^9, 3.6524206868278103`*^9}, {3.652420752564468*^9, 
