Cell[TextData[{
 "Now, note that the ordering of the nodes in terms of dynamical importance \
is preserved with greater accuracy by equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "5", ")"}], TraditionalForm]],ExpressionUUID->
  "18392de9-5aaf-4d8e-8c10-a226523e392f"],
 " for the class of networks ",
 Cell[BoxData[
  FormBox["A2", TraditionalForm]],ExpressionUUID->
  "afd9ec8d-bac0-4d6d-9cdf-e128dc72896d"],
 " by increasing the parameters ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "72fdd032-0653-48d7-a1a3-624b3257ed35"],
 " and ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]],ExpressionUUID->
  "b4e81002-9e63-4c9f-8515-2134dddffbab"],
 " from ",
 Cell[BoxData[
  FormBox["0.1", TraditionalForm]],ExpressionUUID->
  "bee63551-9aaf-44bc-b19e-2fd05d2b8663"],
 " and ",
 Cell[BoxData[
  FormBox["0.75", TraditionalForm]],ExpressionUUID->
  "81f96c50-3650-4108-a157-086f834e7992"],
 " to ",
 Cell[BoxData[
  FormBox["0.9", TraditionalForm]],ExpressionUUID->
  "54d4d0af-5280-4a41-ad84-d12131b578d8"],
 " and ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]],ExpressionUUID->
  "a1d10f15-289d-4bb6-9164-fad98caf014d"],
 " respectively. This is a result of the fact that the effect of increasing \
the number of links in the network by increasing the value of ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "8578fc7c-bccb-4223-8416-36b7eceed45d"],
 " (which will help preserve the ordering of the nodes) outweighs the \
increase in assortativity that results from the increase in the values of ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "2b91c291-208e-4eba-83ef-ca09d8d95da5"],
 " and \[Gamma]. Note however that the ordering of the nodes is still not \
fully preserved in this case unlike for the Erdos-R\[EAcute]nyi networks \
generated by setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "0.9"}], TraditionalForm]],ExpressionUUID->
  "c9571327-9328-40be-b45a-d5c5591c0c3a"],
 ". This is a result of the fact that a network of type ",
 Cell[BoxData[
  FormBox["A2", TraditionalForm]],ExpressionUUID->
  "d7cff77a-b352-41ab-a23d-a2cc51df542c"],
 " generated with parameters ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "0.9"}], TraditionalForm]],ExpressionUUID->
  "41d069fb-0ce6-4b65-b1c8-1952560f44b5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "=", "2"}], TraditionalForm]],ExpressionUUID->
  "f924af8b-899f-452b-bf7a-6e8c0c354321"],
 " is more assortative and has fewer connections than the Erdos-R\[EAcute]nyi \
network in question. The command below now generates a plot which shows the \
relationship between the dynamical importance of a node and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["d", "k"], "in"], 
      SuperscriptBox[
       SubscriptBox["d", "k"], "out"]}], ")"}], 
    FractionBox["1", "2"]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "cdfc7817-3267-4be8-8e46-3eeba519fda1"],
 " for networks in SampleF. Note that, since the ordering of nodes in terms \
of their dynamical importance is not preserved by equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "5", ")"}], TraditionalForm]],ExpressionUUID->
  "e97b221d-25ac-4103-9c76-7c0db02af471"],
 " for the sample of networks in SampleF, we calculate the dynamical \
importance of each node from its definition below:"
}], "Text",
 CellChangeTimes->{{3.818936267556241*^9, 3.8189363043498697`*^9}, 
   3.819527315531705*^9, {3.819528909695756*^9, 3.8195289197910647`*^9}, {
   3.8195406231787567`*^9, 3.8195406420393114`*^9}, {3.81954069882471*^9, 
   3.819540880557829*^9}, {3.8195409384064655`*^9, 3.8195412650208282`*^9}, {
   3.8195414152523513`*^9, 3.819541416353635*^9}, {3.8195414501124554`*^9, 
   3.8195414508976536`*^9}, {3.8195451758167667`*^9, 3.81954525003844*^9}, {
   3.8196267427002845`*^9, 3.819626742833927*^9}, {3.819626776819064*^9, 
   3.8196268139397497`*^9}, {3.819626852370001*^9, 3.8196268601481996`*^9}, {
   3.8196407547188215`*^9, 3.8196407559455547`*^9}, {3.819640804093798*^9, 
   3.819640836715511*^9}},
 FontSize->11,ExpressionUUID->"0a75fe84-0b4a-48b0-8ddf-66eeb4c278c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"List4", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"T", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"SampleF", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}], 
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"SampleF", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
            FractionBox["1", "2"]], ",", 
           RowBox[{"-", 
            RowBox[{"M3", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "k"}], "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "100"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"List4", ",", "T"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "SampleF", "]"}]}], "}"}]}], "]"}], ";", 
  RowBox[{"L4", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"List4", ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "100"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.065"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<(\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(in\)]\)\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(out\)]\)\!\(\*SuperscriptBox[\()\), FractionBox[\(1\), \(2\)]]\)\>\"", ",", 
        "\"\<\!\(\*SubscriptBox[\(I\), \(k\)]\)\>\""}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.818936313029668*^9, 3.8189363301339536`*^9}, {
   3.818936569555997*^9, 3.8189365781140976`*^9}, 3.818940484690606*^9, {
   3.818952101416486*^9, 3.818952101493268*^9}, {3.818954798543011*^9, 
   3.8189547990626483`*^9}, {3.8189576124723787`*^9, 
