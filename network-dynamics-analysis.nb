Cell[TextData[{
 "The plot below now yields the dynamical importances of all nodes in the \
network, where the data point ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "05c4902e-af0b-4394-964b-4392dde30bf2"],
 " corresponds to the dynamical importance of the node ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Ceiling", "[", 
      FractionBox["k", "100"], "]"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        FractionBox["k", "20"], "\[Element]", "Integers"}], ",", "20", ",", 
       RowBox[{"k", "-", 
        RowBox[{"20", " ", 
         RowBox[{"Floor", "[", 
          FractionBox["k", "20"], "]"}]}]}]}], "]"}]}], ")"}], 
   TraditionalForm]],ExpressionUUID->"5b9c32a2-01d4-40bc-8825-553dca0ba35e"],
 " of the lattice:"
}], "Text",
 CellChangeTimes->{{3.8196202882903795`*^9, 3.8196203642891097`*^9}, 
   3.8196203966824684`*^9, {3.8196204307543063`*^9, 3.8196204608468504`*^9}, {
   3.8196204923515577`*^9, 3.819620536030733*^9}, {3.8196278557134137`*^9, 
   3.8196278853322315`*^9}},
 FontSize->11,ExpressionUUID->"4fb41bac-e385-4bfb-93a5-4cdc3dc80e6a"],

