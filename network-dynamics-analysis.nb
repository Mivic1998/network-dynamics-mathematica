Cell[TextData[{
 "Now, note that for the disassortative networks in SampleG, the ordering of \
nodes in terms of dynamical importance is preserved even more by equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "5", ")"}], TraditionalForm]],ExpressionUUID->
  "75058311-8594-4e48-a10a-ee852e406a45"],
 " than for the Erdos-R\[EAcute]nyi networks with the same value of ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "8a8c6f95-d2e8-4c96-9de9-29cd705762db"],
 ". This is due to the fact that for nodes of higher degree in these \
networks, which one might expect to have a higher eigenvector centrality, are \
connected to nodes of lower degree, which ensures that the eigenvector \
centralities of these nodes will not be too large. Meanwhile, nodes which \
tend to be connected to nodes of higher degree are themselves of lower \
degree, which will also moderate the eigenvector centralities of such nodes. \
Thus, the disassortative property of the network ensures that the eigenvector \
centralities of all nodes in the network are very similar, which means that \
the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox["v", "k"], 
      SubscriptBox["u", "k"]}], 
     RowBox[{"v", ".", "u"}]], 
    RowBox[{"<<", "1"}]}], TraditionalForm]],ExpressionUUID->
  "e1cfb54d-31b3-4eef-8971-396e1f020030"],
 " holds for all ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "3ebb1bb9-d1df-4d27-a657-162aced8841f"],
 ". The command below now generates a plot which shows the relationship \
between the dynamical importance of a node and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["d", "k"], "in"], 
      SuperscriptBox[
       SubscriptBox["d", "k"], "out"]}], ")"}], 
    FractionBox["1", "2"]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "ebd21374-0c49-4a46-b42e-3cac79f812db"],
 " for the networks in SampleG. Note that, since the ordering of nodes in \
terms of their dynamical importance is preserved by equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "5", ")"}], TraditionalForm]],ExpressionUUID->
  "fcd7c4d4-1e15-4091-9061-913848b65880"],
 " for the networks in SampleG, we can calculate the dynamical importance of \
each node directly from the equation in question, which is what we do below:"
}], "Text",
 CellChangeTimes->{{3.8189361550738907`*^9, 3.8189361910627236`*^9}, {
  3.8195289416554236`*^9, 3.819528950826619*^9}, {3.8195303339311113`*^9, 
  3.8195303569618406`*^9}, {3.8195439429160337`*^9, 3.8195439692758083`*^9}, {
  3.8195443134041786`*^9, 3.8195444028769455`*^9}, {3.8195444611184273`*^9, 
  3.8195445332507467`*^9}, {3.8195445904996147`*^9, 3.8195446695201936`*^9}, {
  3.8195447016097035`*^9, 3.8195447258014503`*^9}, {3.8195447666839876`*^9, 
  3.8195447831343555`*^9}, {3.819544910641017*^9, 3.8195450926688724`*^9}, {
  3.8195451250440345`*^9, 3.8195451469114523`*^9}, {3.8195452555323353`*^9, 
  3.8195452632745886`*^9}, {3.819627319616262*^9, 3.8196273234819613`*^9}, {
  3.8196273614873095`*^9, 3.819627366862932*^9}, {3.819641298924284*^9, 
  3.8196413333143053`*^9}},
 FontSize->11,ExpressionUUID->"fe89d710-dd2d-4625-ad1c-8a425f8c3eb1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"List5", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "=", 
       RowBox[{
        RowBox[{"Eigenvectors", "[", 
         RowBox[{"N", "[", 
          RowBox[{"SampleG", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"v", "=", 
       RowBox[{
        RowBox[{"Eigenvectors", "[", 
         RowBox[{"N", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"SampleG", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"T", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"SampleG", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}], 
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"SampleG", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
            FractionBox["1", "2"]], ",", 
           RowBox[{"Re", "[", 
            FractionBox[
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"[", "k", "]"}], "]"}], 
              RowBox[{"v", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], 
             RowBox[{"u", ".", "v"}]], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "100"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"List5", ",", "T"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "SampleG", "]"}]}], "}"}]}], "]"}], ";", 
  RowBox[{"L5", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"List5", ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "100"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.065"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", "Green"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<(\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(in\)]\)\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(out\)]\)\!\(\*SuperscriptBox[\()\), FractionBox[\(1\), \(2\)]]\)\>\"", ",", 
        "\"\<\!\(\*SubscriptBox[\(I\), \(k\)]\)\>\""}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.818936121499629*^9, 3.8189361396062274`*^9}, {
  3.818957660160906*^9, 3.818957670776533*^9}, {3.818958802033721*^9, 
  3.8189588116948953`*^9}, {3.8194689262432384`*^9, 3.8194689292012167`*^9}, {
  3.8194692487538967`*^9, 3.8194692554636307`*^9}, {3.819469296021224*^9, 
  3.8194692961214857`*^9}, {3.8194699332956457`*^9, 3.819469942437035*^9}, {
  3.819525403163473*^9, 3.8195254113705435`*^9}, {3.8195328705812087`*^9, 
  3.8195328709819813`*^9}, {3.819533067294175*^9, 3.819533070985047*^9}, {
  3.8195335956336145`*^9, 3.819533596249796*^9}, {3.819534046336495*^9, 
  3.81953404948886*^9}, {3.819534571776825*^9, 3.8195345729005437`*^9}, {
  3.8195428296855416`*^9, 3.8195428342767806`*^9}, {3.8195429485458565`*^9, 
  3.819542948624135*^9}, {3.819622692232066*^9, 3.81962269418983*^9}},
 FontSize->11,
 CellLabel->
  "In[862]:=",ExpressionUUID->"279dbe4c-20a6-433a-8980-c7982111db1d"],

Cell[TextData[{
 "The plot below now establishes the relationship between the dynamical \
importance of a node and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["d", "k"], "in"], 
      SuperscriptBox[
       SubscriptBox["d", "k"], "out"]}], ")"}], 
    FractionBox["1", "2"]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "e4f4bf39-a044-47dc-a3d5-afdd361009fe"],
 " for networks in the SampleG (which corresponds to the green plot below), \
SampleF (which corresponds to the red plot below) and SampleE (which \
corresponds to the blue plot below): "
}], "Text",
 CellChangeTimes->{{3.819115566966853*^9, 3.8191155949263906`*^9}, {
  3.8195302834611716`*^9, 3.8195303001896505`*^9}, {3.8195303686781273`*^9, 
  3.8195305046240234`*^9}, {3.819543097156887*^9, 3.819543100460007*^9}, {
  3.8196413657385826`*^9, 3.8196413729552813`*^9}},
 FontSize->11,ExpressionUUID->"53c83208-a34a-4067-b1b0-901fa9df8a17"],

