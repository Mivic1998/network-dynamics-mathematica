Cell[TextData[{
 "Summing ",
 Cell[BoxData[
  FormBox["U", TraditionalForm]],ExpressionUUID->
  "f5d3c056-cf2d-4c16-9ece-93e44aecc49d"],
 " and ",
 Cell[BoxData[
  FormBox["V", TraditionalForm]],ExpressionUUID->
  "1d12457b-1e6a-4f28-9e9c-4f96d37a82b9"],
 " yields the desired permutation, which we then apply to ",
 Cell[BoxData[
  FormBox["B1", TraditionalForm]],ExpressionUUID->
  "e74296f8-f744-400b-b26d-0398a49cd83c"],
 ":"
}], "Text",
 CellChangeTimes->{{3.8180742214593525`*^9, 3.8180742308994865`*^9}, {
  3.8193041646083794`*^9, 3.819304214205681*^9}, {3.819304795789647*^9, 
  3.819304816218027*^9}},
 FontSize->11,ExpressionUUID->"6b704fe4-c054-4102-ba0e-10040faac02e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"U", "+", "V"}]}], ";", 
  RowBox[{"BlockMatrix", "=", 
   RowBox[{"P", ".", "B1", ".", 
    RowBox[{"Transpose", "[", "P", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8180720815235696`*^9, 3.818072089441626*^9}, 
   3.819057458363312*^9},
 FontSize->11,
 CellLabel->
