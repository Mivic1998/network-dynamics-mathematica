 FontSize->11,ExpressionUUID->"78ef354c-3ab7-4eee-b2cc-5c130509efe1"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"Re", "[", 
          StyleBox["\[CapitalDelta]EvnE",
           FontWeight->"Bold"], 
          StyleBox["]",
           FontWeight->"Bold"]}], 
         StyleBox["[",
          FontWeight->"Bold"], 
         StyleBox[
          RowBox[{"[", "i", "]"}],
          FontWeight->"Bold"], 
         StyleBox["]",
          FontWeight->"Bold"]}]}], ",", 
       RowBox[{"Re", "[", 
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Eigenvectors", "[", 
             RowBox[{"N", "[", "A3", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          RowBox[{
           RowBox[{
            RowBox[{"Eigenvectors", "[", 
             RowBox[{"N", "[", 
              RowBox[{"Transpose", "[", "A3", "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], 
         RowBox[{
          RowBox[{
           RowBox[{"Eigenvectors", "[", 
            RowBox[{"N", "[", "A3", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ".", 
          RowBox[{
           RowBox[{"Eigenvectors", "[", 
            RowBox[{"N", "[", 
             RowBox[{"Transpose", "[", "A3", "]"}], "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "100"}], "}"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "Full"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\!\(\*SubscriptBox[\(I\), \(k\)]\)\>\"", ",", 
      "\"\<\!\(\*SubscriptBox[OverscriptBox[\(I\), \(^\)], \(k\)]\)\>\""}], 
     "}"}]}]}], "]"}]], "Input",
