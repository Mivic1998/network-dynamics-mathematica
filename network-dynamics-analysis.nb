Cell[TextData[{
 "In order to speed up the required computation, we use the property that the \
square lattice generated is symmetric and produce a list ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]Evn3", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "dda3234f-3041-4cb3-997e-0b3f38a716eb"],
 " which contains only the dynamical importances of the first ",
 Cell[BoxData[
  FormBox["200", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "de45c059-49c8-4681-acfc-2b8766b0dc33"],
 " nodes in the network by adjusting the function ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "e67093c6-027d-4235-a8a2-4790d147024f"],
 ". We then reverse this list and append it to \[CapitalDelta]Evn3, which \
will yield a list containing the dynamical importances of all ",
 Cell[BoxData[
  FormBox["400", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "b5b6f667-f7d5-4d23-ae4e-5d0d0d77103f"],
 " nodes in the network."
}], "Text",
 CellChangeTimes->{{3.819619734177411*^9, 3.8196197455300426`*^9}, {
  3.819619984856906*^9, 3.8196200153583326`*^9}, {3.8196201578272943`*^9, 
  3.819620285205591*^9}, {3.819627823494585*^9, 3.819627849226761*^9}},
 FontSize->11,ExpressionUUID->"97e72a70-482f-4c23-876c-18f805917b3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[Lambda]", "3"], "=", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", "B1", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
  RowBox[{
   StyleBox["\[CapitalDelta]Evn3",
    FontWeight->"Bold"], "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"f", "[", 
   RowBox[{"B1", ",", 
    SubscriptBox["\[Lambda]", "3"]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8177581627806673`*^9, 3.817758167004343*^9}, {
  3.819120711638873*^9, 3.8191207178233223`*^9}, {3.819483580956044*^9, 
  3.8194835834281464`*^9}, {3.8195591011464567`*^9, 3.819559103092287*^9}, {
