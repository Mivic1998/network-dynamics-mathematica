   3.8033794273583603`*^9}, {3.8033796228154287`*^9, 3.803379640089072*^9}, {
   3.8033805615415697`*^9, 3.803380646874024*^9}, {3.803630406717191*^9, 
   3.8036304192536693`*^9}, {3.803630518297773*^9, 3.803630518609902*^9}, {
   3.8036305600929832`*^9, 3.8036305600929832`*^9}, {3.8036307783781133`*^9, 
   3.8036308606011815`*^9}, {3.8053681946307354`*^9, 
