        RowBox[{"{", 
         RowBox[{
         "\"\<(\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \(in\)]\)\!\(\
\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(out\)]\)\!\(\*SuperscriptBox[\()\), FractionBox[\(1\), \(2\)]]\)\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(I\), \(k\)]\)\>\""}], "}"}]}]}], "]"}], 
     ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", "A2", "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}], 
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"Transpose", "[", "A2", "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
            FractionBox["1", "2"]], 
           StyleBox[",",
            FontWeight->"Bold"], 
           RowBox[{"-", 
            StyleBox[
             RowBox[{"\[CapitalDelta]Evn2", "[", 
              RowBox[{"[", "k", "]"}], "]"}],
             FontWeight->"Bold"]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "100"}], "}"}]}], "]"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "Full"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<(\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \(in\)]\)\!\(\
\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(out\)]\)\!\(\*SuperscriptBox[\()\), FractionBox[\(1\), \(2\)]]\)\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(I\), \(k\)]\)\>\""}], "}"}]}]}], "]"}]}], 
    "}"}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.8190368842216415`*^9, 3.8190369576480684`*^9}, {
