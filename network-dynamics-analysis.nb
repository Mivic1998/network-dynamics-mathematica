Cell[CellGroupData[{

Cell[TextData[{
 "        ",
 StyleBox["Dynamical Importance in the Square Lattice",
  FontSize->20,
  FontColor->RGBColor[0.5019607843137255, 0., 0.]]
}], "Subtitle",
 CellChangeTimes->{{3.9987363248153744`*^9, 3.9987363634514637`*^9}, {
  3.9987367506371937`*^9, 3.9987367521543217`*^9}, {3.9987369411403065`*^9, 
  3.9987369449025784`*^9}},ExpressionUUID->"a151196d-1d7e-7542-bde7-\
7bf27c0ba217"],

Cell["\<\
I calculate the dynamical importance of the nodes in the square lattice and \
examine how a node\[CloseCurlyQuote]s position within the regular network \
affects its importance.\
\>", "Text",
 CellChangeTimes->{{3.598452093952716*^9, 3.598452204485716*^9}, {
   3.652420633161273*^9, 3.6524206868278103`*^9}, {3.652420752564468*^9, 
