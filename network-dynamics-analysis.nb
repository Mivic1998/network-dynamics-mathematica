  3.819390975562727*^9, 3.8193909769327836`*^9}, {3.819393534179609*^9, 
  3.819393535349661*^9}, {3.8193944897572174`*^9, 3.819394489819894*^9}, {
  3.8193954371318197`*^9, 3.8193954386341777`*^9}, {3.8193963539485364`*^9, 
  3.81939635484908*^9}, {3.8193980310391064`*^9, 3.8193980316618996`*^9}, {
  3.8193991972300797`*^9, 3.819399198293208*^9}, {3.8194690995058575`*^9, 
  3.8194691024170656`*^9}},
 FontSize->11,
 CellLabel->
  "In[633]:=",ExpressionUUID->"409e9b9a-fa15-42ac-91f9-e1284c3e2747"],

Cell[TextData[{
 StyleBox["Note that the networks comprising SampleF will generally be highly \
assortative as a result of large ",
  FontSize->11],
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FontSize->11,ExpressionUUID->"7be77a08-ba61-4ae3-a91c-4b4f62d18b06"],
 StyleBox[" and ",
  FontSize->11],
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]],
  FontSize->11,ExpressionUUID->"03316bc1-6946-4d53-8d73-21011921c4f9"],
 StyleBox[". Just to confirm this numerically, we compute the assortativity \
of the first network in SampleF:",
  FontSize->11]
}], "Text",
 CellChangeTimes->{{3.8196362912463307`*^9, 
  3.8196363130070934`*^9}},ExpressionUUID->"45bb088b-192f-47b3-82d2-\
20c1897c49b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Assortativity", "[", 
   RowBox[{"SampleF", "[", 
    RowBox[{"[", "1", "]"}], "]"}], "]"}], "//", "N"}]], "Input",
 CellChangeTimes->{{3.8196363151254363`*^9, 3.819636333279871*^9}},
 FontFamily->"Consolas",
 FontSize->11,
 CellLabel->
  "In[881]:=",ExpressionUUID->"3bc74487-c73d-47eb-ad81-7e4b8dd62802"],

Cell[BoxData["0.48403533380567704`"], "Output",
 CellChangeTimes->{{3.8196363282742586`*^9, 3.8196363339421005`*^9}},
 FontFamily->"Consolas",
 FontSize->11,
 CellLabel->
  "Out[881]=",ExpressionUUID->"bfec399d-736a-4bc2-b161-3eb9c97dcbbf"]
}, Open  ]],

Cell[TextData[{
 "Now, the command below generates a matrix ",
 Cell[BoxData[
  FormBox["M1", TraditionalForm]],ExpressionUUID->
  "589ea401-2026-4d62-be65-76b5e08ce63a"],
 ", where entry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "63c59827-2d41-470a-a1a8-7c4a4f121f46"],
 " of the matrix in question yields the dynamical importance of node ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "36136ffb-4e4c-4f5c-be35-ba1dfc1164b5"],
 " of the network corresponding to the adjacency matrix ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "7394d23d-d1f7-4645-ae01-252062fa5cd0"],
 " in SampleF:"
}], "Text",
 CellChangeTimes->{{3.818936427448827*^9, 3.818936449024155*^9}, {
  3.819527140124381*^9, 3.8195271473905706`*^9}, {3.81953093926396*^9, 
  3.8195309406342373`*^9}, {3.8195422060464*^9, 3.8195422075102634`*^9}, {
  3.8195436052286835`*^9, 3.8195436435239944`*^9}, {3.8196267203949747`*^9, 
  3.8196267206891565`*^9}, {3.8196362095059175`*^9, 3.819636287786549*^9}},
 FontSize->11,ExpressionUUID->"dc2d72c4-5544-4665-ab1b-3c1c7e15a580"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["\[CapitalDelta]EvnF",
    FontWeight->"Bold"], "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", "=", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", "[", 
          RowBox[{"SampleF", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"f", "[", 
       RowBox[{
        RowBox[{"SampleF", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\[Lambda]"}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "SampleF", "]"}]}], "}"}]}], "]"}], ";", 
  RowBox[{"M3", "=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Re", "[", 
      StyleBox["\[CapitalDelta]EvnF",
       FontWeight->"Bold"], 
      StyleBox["]",
       FontWeight->"Bold"]}], 
     StyleBox[",",
      FontWeight->"Bold"], 
     StyleBox[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "SampleF", "]"}], ",", "100"}], "}"}],
      FontWeight->"Bold"]}], 
    StyleBox["]",
     FontWeight->"Bold"]}]}], 
  StyleBox[";",
   FontWeight->"Bold"]}]], "Input",
 CellChangeTimes->{{3.818936454268173*^9, 3.8189364607358494`*^9}, 
   3.8189561134772186`*^9, {3.819468762839722*^9, 3.81946876549087*^9}, {
   3.8194691263500648`*^9, 3.819469137611644*^9}, {3.819469493726241*^9, 
   3.819469493795062*^9}},
 FontSize->11,
 CellLabel->
  "In[636]:=",ExpressionUUID->"7942c5e5-30dd-4c29-9c3f-a61577041f21"],

Cell[TextData[{
 "The figure below now demonstrates the accuracy with which the dynamical \
importances of the nodes are represented by equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "5", ")"}], TraditionalForm]],ExpressionUUID->
  "215dcaf4-3e5d-4d94-8095-ce381cd38dc5"],
 " from the paper by Restrepo, Ott and Hunt for the first network (chosen \
arbitrarily) in SampleF:"
}], "Text",
 CellChangeTimes->{{3.819018434055582*^9, 3.8190184386315336`*^9}, {
  3.8195298796519823`*^9, 3.8195300277280016`*^9}, {3.8196416109912024`*^9, 
  3.819641616475574*^9}},
 FontSize->11,ExpressionUUID->"32cc0b6a-386b-415a-878b-4f3c354f347b"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"M3", 
         StyleBox["[",
          FontWeight->"Bold"], 
         StyleBox[
          RowBox[{"[", 
           RowBox[{"1", ",", "i"}], "]"}],
          FontWeight->"Bold"], 
         StyleBox["]",
          FontWeight->"Bold"]}]}], ",", 
       RowBox[{"Re", "[", 
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Eigenvectors", "[", 
             RowBox[{"N", "[", 
              RowBox[{"SampleF", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          RowBox[{
           RowBox[{
            RowBox[{"Eigenvectors", "[", 
             RowBox[{"N", "[", 
              RowBox[{"Transpose", "[", 
               RowBox[{"SampleF", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], 
         RowBox[{
          RowBox[{
           RowBox[{"Eigenvectors", "[", 
            RowBox[{"N", "[", 
             RowBox[{"SampleF", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ".", 
          RowBox[{
           RowBox[{"Eigenvectors", "[", 
            RowBox[{"N", "[", 
             RowBox[{"Transpose", "[", 
              RowBox[{"SampleF", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "100"}], "}"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "Full"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\!\(\*SubscriptBox[\(I\), \(k\)]\)\>\"", ",", 
      "\"\<\!\(\*SubscriptBox[OverscriptBox[\(I\), \(^\)], \(k\)]\)\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.819018431482977*^9, 3.8190184321837935`*^9}, {
  3.819020252022462*^9, 3.81902027709552*^9}, {3.8191108353162355`*^9, 
