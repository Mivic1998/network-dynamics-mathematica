Cell[TextData[{
 "Thus, we have constructed the permutation correctly and shown that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"20", "\[Times]", "20"}], TraditionalForm]],ExpressionUUID->
  "a0280604-2fc2-4ba7-83b9-cb725d67549b"],
 " square lattice is bipartite. Note that this implies that any two step path \
must go from a node in one set to a node in same set, which is why we get \
following figure when we plot the network corresponding to the adjacency \
matrix ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["B1", "2"], TraditionalForm]],ExpressionUUID->
  "dcd68cd2-e242-4ea4-9405-fb54c1f57d2c"],
 ":"
}], "Text",
 CellChangeTimes->{{3.8181035962736216`*^9, 3.8181036010288105`*^9}, {
  3.8193056208581686`*^9, 3.8193057284253707`*^9}, {3.819311012759098*^9, 
  3.8193110169698315`*^9}, {3.819627802269354*^9, 3.81962780344521*^9}},
 FontSize->11,ExpressionUUID->"e71d354a-840b-48bd-bd09-66073858d34a"],

Cell[BoxData[
 RowBox[{"GraphPlot3D", "[", 
  RowBox[{"MatrixPower", "[", 
