Cell[TextData[{
 "In the analysis that follows, we will generate all networks of the type ",
 Cell[BoxData[
  FormBox["A2", TraditionalForm]],ExpressionUUID->
  "9932c144-ddba-4efc-86c0-fd308ef5481d"],
 " according to the distribution of points above. This will allow us, for \
example, to see which node has the highest dynamical importance in the \
network, and locate the point associated with that particular node. Now, the \
command below generates a network of the second type ",
 Cell[BoxData[
  FormBox["A2", TraditionalForm]],ExpressionUUID->
  "20cf47c6-b6e7-43b3-94aa-de568c443e07"],
 " with parameters ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "0.1"}], TraditionalForm]],ExpressionUUID->
  "f35862bc-6aee-429b-9cdd-ff3a127b03f8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", "=", "0.75"}], TraditionalForm]],ExpressionUUID->
  "1af2f77c-bf8f-4ebf-956e-65559d3f9a9f"],
 " and produces the corresponding list of dynamical importances of links \
\[CapitalDelta]Evl2 for this network:"
}], "Text",
 CellChangeTimes->{{3.819383349679352*^9, 3.8193834239017696`*^9}, {
   3.8193834560776844`*^9, 3.8193835086370606`*^9}, {3.819383654512767*^9, 
   3.819383656355835*^9}, {3.8193837907612324`*^9, 3.8193837911940794`*^9}, {
   3.8195262544893*^9, 3.819526305305974*^9}, {3.819526373293721*^9, 
   3.8195265208854856`*^9}, 3.819619627545573*^9, {3.819625302485305*^9, 
   3.8196253136474543`*^9}},
 FontSize->11,ExpressionUUID->"0d446903-ce59-4f2f-a681-ea5c494e0752"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A2", "=", 
   RowBox[{
    SubscriptBox["A", "2"], "[", 
    RowBox[{"0.1", ",", "0.75"}], "]"}]}], ";", 
  RowBox[{
   SubscriptBox["\[Lambda]", "2"], "=", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", "A2", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
  RowBox[{
   StyleBox["\[CapitalDelta]Evl2",
    FontWeight->"Bold"], "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"d", "[", 
   RowBox[{"A2", ",", 
    SubscriptBox["\[Lambda]", "2"]}], "]"}]}]], "Input",
 FontSize->11,
 CellLabel->
  "In[545]:=",ExpressionUUID->"9d30a6a8-47ae-483f-861c-86f06194f8a0"],

Cell[TextData[{
 "The function below now allows us to apply equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "4", ")"}], TraditionalForm]],ExpressionUUID->
  "d47c841d-8ac7-46c1-92c9-64167a66a236"],
 " from the paper by Restrepo, Ott and Hunt (2006) to each entry of an \
adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "aaee2a0d-22dd-4758-af9e-c65fbcf25f0a"],
 ":"
}], "Text",
 CellChangeTimes->{{3.819457205640379*^9, 3.819457209413055*^9}, {
  3.819457433680805*^9, 3.819457442143815*^9}, {3.819457810648259*^9, 
  3.819457927897947*^9}, {3.8196253236088333`*^9, 3.819625341191819*^9}},
 FontSize->11,ExpressionUUID->"4fcbd49f-0b78-43d8-a4d7-df70ca7b01ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"b", "[", 
   RowBox[{"A_", ",", "u_", ",", "v_", ",", "\[Lambda]_"}], "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], 
      RowBox[{"Re", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"v", "[", 
          RowBox[{"[", "i", "]"}], "]"}], 
         RowBox[{"u", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], 
        RowBox[{"\[Lambda]", " ", 
         RowBox[{"v", ".", "u"}]}]], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "A", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8192063135976152`*^9, 3.8192063160051365`*^9}},
 FontSize->11,
 CellLabel->
  "In[557]:=",ExpressionUUID->"519f4f15-2453-4852-b298-055b8536af3d"],

Cell[TextData[{
 "The command below calculates the left and right eigenvectors corresponding \
to the eigenvalue of largest absolute value for the adjacency matrices \
associated with the networks ",
 Cell[BoxData[
  FormBox["A1", TraditionalForm]],ExpressionUUID->
  "8795fe8b-33f3-46a5-b330-4848148f4c83"],
 " and ",
 Cell[BoxData[
  FormBox["A2", TraditionalForm]],ExpressionUUID->
  "969004ed-d4bd-4114-86f2-f82046aa3f01"],
 " respectively:"
}], "Text",
 CellChangeTimes->{{3.8194579706449375`*^9, 3.819458084440956*^9}, {
  3.819625350881858*^9, 3.8196253528635545`*^9}, {3.819639142787569*^9, 
  3.819639148708732*^9}},
 FontSize->11,ExpressionUUID->"de48f08d-de1b-44f5-9b73-d09e92116a19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"v1", "=", 
   RowBox[{
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"N", "[", "A1", "]"}], "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
  RowBox[{"u1", "=", 
   RowBox[{
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"N", "[", "A1", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
  RowBox[{"v2", "=", 
   RowBox[{
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"N", "[", "A2", "]"}], "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
  RowBox[{"u2", "=", 
   RowBox[{
    RowBox[{"Eigenvectors", "[", 
     RowBox[{"N", "[", "A2", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.819035830105236*^9, 3.819035836319121*^9}},
 FontSize->11,
 CellLabel->
  "In[558]:=",ExpressionUUID->"91f174a2-88aa-4177-bcd1-c2a24643d453"],

Cell[TextData[{
 "The two plots below now show how accurately the dynamical importance of the \
nodes in each of the networks ",
 Cell[BoxData[
  FormBox["A1", TraditionalForm]],ExpressionUUID->
  "29226de3-8ddf-40c1-8418-111d7489bd64"],
 " and ",
 Cell[BoxData[
  FormBox["A2", TraditionalForm]],ExpressionUUID->
  "f364a905-8390-4ec8-a3a7-2326845c02f4"],
 " are represented by equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "4", ")"}], TraditionalForm]],ExpressionUUID->
  "a3e093d1-c7ca-4fda-956c-d2406b069f05"],
 " from the paper by Restrepo, Ott and Hunt (2006). The leftmost plot \
corresponds to the case of the network ",
 Cell[BoxData[
  FormBox["A1", TraditionalForm]],ExpressionUUID->
  "543f43d2-2c15-4273-98d4-3f03a4ec247b"],
 ", which shows that there is a linear relationship between equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "4", ")"}], TraditionalForm]],ExpressionUUID->
  "f1ef830d-dcfb-4e06-8e5a-a6ef78c5098d"],
 " and dynamical importance, and while the relative ranking of the nodes in \
terms of dynamical importance is mostly preserved by the approximation, there \
are deviations which result from the fact that second order terms are \
neglected. Specifically, it is assumed in the paper that the changes in the \
components of the right eigenvector ",
 Cell[BoxData[
  FormBox["u", TraditionalForm]],ExpressionUUID->
  "4cb0c208-746c-473e-a087-cd4b9d156ed6"],
 " corresponding to the largest eigenvalue ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]],ExpressionUUID->
  "5e679c36-1c3b-4737-b398-4857a211e2ae"],
 " as well as \[Lambda] itself are small when we remove a link. However, for \
a network that has a small number of links this will not be the case. To see \
this more clearly, consider a network that is highly connected. For such a \
network, we would have a large number of multiple step paths running through \
each node. Now, by removing a link from the network, the eigenvector \
components corresponding to the nodes that had a large number of multiple \
step paths which included the removed link running through them prior to the \
link\[CloseCurlyQuote]s removal will incur a disproportionate reduction, \
while the magnitude of the reduction in the largest eigenvalue will depend on \
how central the link was to far reaching connections within the network. In \
the case of a highly connected network however, these reductions will be \
small, since the removal of the link will only reduce the number of multiple \
step paths in the network by a small percentage relative to the number of \
these paths that existed in the first place. This means that the largest \
eigenvalue and the components of the corresponding right eigenvector will \
only change by a small amount relative to their initial values for such \
networks. However, for the network ",
 Cell[BoxData[
  FormBox["A1", TraditionalForm]],ExpressionUUID->
  "76735a5e-c525-4d99-8d2b-c5763a13ab59"],
 " which was generated by setting ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "9bc980f6-34eb-459a-855a-00fa790142c7"],
 " equal to ",
 Cell[BoxData[
  FormBox["0.1", TraditionalForm]],ExpressionUUID->
  "dd3e016e-d364-4c8d-9493-c42f93d2f7c8"],
 ", the number of links in the network is relatively small, meaning that ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[CapitalDelta]",
    FontSlant->"Plain"], TraditionalForm]],ExpressionUUID->
  "dfb5d67d-d1f3-495c-8c47-d7dded1e55b9"],
 Cell[BoxData[
  FormBox["u", TraditionalForm]],ExpressionUUID->
  "8b00e8a7-b7e5-4a6c-91f4-012848244ea7"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[CapitalDelta]",
    FontSlant->"Plain"], TraditionalForm]],ExpressionUUID->
  "1fc8dd7c-bd85-42d2-a469-962362144b71"],
 "\[Lambda] will be large when links with high dynamical importance are \
removed, resulting in equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "4", ")"}], TraditionalForm]],ExpressionUUID->
  "93fdc63c-d4c0-4a14-8999-baae7f0d28a0"],
 " failing to maintain the ordering of the links with respect to dynamical \
importance in this case."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQB2IQbb/lxHHO0jeOvG8PnQTRUSvFL4HoeSXZ10D0muQP
D0F0kHTDUxCdcP2yBBeQXqTzVRpEfy33VgDRYfnX1UH0nMf2OiB6Z3OKAVic
NcMCRF8TqLMC0RIXeXxBdMdSVn8QLWavsJEbSKetzT0Eot+WPjgJog3inoLp
+YvVnoHoW1FT34Boqb+F/0C0y1Ijbh4gHXe5SAxE87FxGYLofauVTUH0DNML
5iC6rSDEFkQ/Zd4GphftlXAG0RGx5/NAdEazdDGIPqf7uAJER+Wr1IFoMZG0
bhDd3phQFg2kdWKtK0C0xOesWhCdEdUFpjuiH7eC6N2N/7tANNfPwokg+kip
5yQQbZHTYJwEss+5H0wDAH0pp7g=
  "],
 FontSize->11,ExpressionUUID->"a70024b0-0ed0-48be-9769-a1275710b772"],

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"A1", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"Ceiling", "[", 
                  FractionBox["i", "100"], "]"}], ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    FractionBox["i", "100"], "\[Element]", "Integers"}], ",", 
                   "100", ",", 
                   RowBox[{"i", "-", 
                    RowBox[{"100", " ", 
                    RowBox[{"Floor", "[", 
                    FractionBox["i", "100"], "]"}]}]}]}], "]"}]}], "]"}], 
               "]"}], ">", "0"}], ",", 
             RowBox[{
              RowBox[{"b", "[", 
               RowBox[{"A1", ",", "u1", ",", "v1", ",", 
                SubscriptBox["\[Lambda]", "1"]}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "Indeterminate"}], "]"}], 
           ",", 
           RowBox[{"-", 
            StyleBox[
             RowBox[{"\[CapitalDelta]Evl1", "[", 
              RowBox[{"[", "i", "]"}], "]"}],
             FontWeight->"Bold"]}]}], 
          StyleBox["}",
           FontWeight->"Bold"]}], 
         StyleBox[",",
          FontWeight->"Bold"], 
         StyleBox[
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "10000"}], "}"}],
          FontWeight->"Bold"]}], 
        StyleBox["]",
         FontWeight->"Bold"]}], 
       StyleBox[",",
        FontWeight->"Bold"], 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\!\(\*SubscriptBox[OverscriptBox[\(I\), \(^\)], \(ij\)]\)\>\"", 
          ",", "\"\<\!\(\*SubscriptBox[\(I\), \(ij\)]\)\>\""}], "}"}]}]}], 
      StyleBox["]",
       FontWeight->"Bold"]}], 
     StyleBox[",",
      FontWeight->"Bold"], 
     StyleBox[
      RowBox[{"ListPlot", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"A2", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"Ceiling", "[", 
                   FractionBox["i", "100"], "]"}], ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    FractionBox["i", "100"], "\[Element]", "Integers"}], ",", 
                    "100", ",", 
                    RowBox[{"i", "-", 
                    RowBox[{"100", " ", 
                    RowBox[{"Floor", "[", 
                    FractionBox["i", "100"], "]"}]}]}]}], "]"}]}], "]"}], 
                "]"}], ">", "0"}], ",", 
              RowBox[{
               RowBox[{"b", "[", 
                RowBox[{"A2", ",", "u2", ",", "v2", ",", 
                 SubscriptBox["\[Lambda]", "2"]}], "]"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", "Indeterminate"}], "]"}], 
            ",", 
            RowBox[{"-", 
             RowBox[{"\[CapitalDelta]Evl2", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "10000"}], "}"}]}], "]"}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
          "\"\<\!\(\*SubscriptBox[OverscriptBox[\(I\), \(^\)], \(ij\)]\)\>\"",
            ",", "\"\<\!\(\*SubscriptBox[\(I\), \(ij\)]\)\>\""}], "}"}]}]}], 
       "]"}],
      FontWeight->"Bold"]}], 
    StyleBox["}",
     FontWeight->"Bold"]}], 
   StyleBox["}",
    FontWeight->"Bold"]}], 
  StyleBox["]",
   FontWeight->"Bold"]}]], "Input",
 CellChangeTimes->{{3.819207884861225*^9, 3.8192081300312653`*^9}, {
   3.8192082626500783`*^9, 3.819208300035503*^9}, {3.8192083413108935`*^9, 
