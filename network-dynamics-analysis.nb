Cell[TextData[{
 "In what follows we restrict our analysis to the dynamical importances of \
nodes in the networks that we generate below, since the results that we \
derive will generalise very easily to the dynamical importance of links. The \
list SampleC below contains ",
 Cell[BoxData[
  FormBox["500", TraditionalForm]],ExpressionUUID->
  "a9295bf1-d002-4549-9198-80b7a5e6bd0f"],
 " adjacency matrices corresponding to networks of type ",
 Cell[BoxData[
  FormBox["A1", TraditionalForm]],ExpressionUUID->
  "c1689844-ff53-497f-861d-f6e5564faab1"],
 " with the parameter ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "f8684b05-cd32-4112-9e4f-1d26b0d485bc"],
 " set to ",
 Cell[BoxData[
  FormBox["0.1", TraditionalForm]],ExpressionUUID->
  "77da9455-b1a7-41a0-ba31-ecb1a6cd1730"],
 ":"
}], "Text",
 CellChangeTimes->{{3.819459265285974*^9, 3.819459276430032*^9}, {
  3.8195261811744504`*^9, 3.8195262198256016`*^9}, {3.819526664760044*^9, 
  3.819526671162483*^9}, {3.8195267371876926`*^9, 3.8195268026847773`*^9}, {
  3.8195308022984943`*^9, 3.8195308896595955`*^9}, {3.8195418768195133`*^9, 
  3.819541912022279*^9}, {3.8196264180426164`*^9, 3.819626430026569*^9}, {
  3.8196402602975454`*^9, 3.819640299752976*^9}},
 FontSize->11,ExpressionUUID->"84f640b2-6062-4ff7-ad37-4dcf1bedb76e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SampleC", "=", 
   RowBox[{"SampleA", "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "500"}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.818243074796789*^9, 3.8182431379718876`*^9}, {
  3.8188488071900563`*^9, 3.8188488226550694`*^9}, {3.818926824622452*^9, 
  3.8189268279076653`*^9}, {3.81895135560503*^9, 3.818951356207444*^9}},
 FontSize->11,
 CellLabel->
  "In[565]:=",ExpressionUUID->"9765500e-b28e-4d18-98c2-d3b05b82fb19"],

Cell[TextData[{
 "Meanwhile, the list SampleD below contains 500 adjacency matrices \
corresponding to networks of type ",
 Cell[BoxData[
  FormBox["A2", TraditionalForm]],ExpressionUUID->
  "0396057a-24dd-4af2-93cd-9dcb297c5230"],
 " with the parameters ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "3a4eb206-5780-4652-a64f-a2e822d0983b"],
 " and ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]],ExpressionUUID->
  "69f22891-e601-435f-9dee-aec995bfdd74"],
 " set to 0.1 and ",
 Cell[BoxData[
  FormBox["0.75", TraditionalForm]],ExpressionUUID->
  "c7710e1c-e5da-4f2c-96a1-4f03cfdda7c0"],
 " respectively:"
}], "Text",
 CellChangeTimes->{{3.8195267739906626`*^9, 3.819526775115797*^9}, {
   3.8195268074737225`*^9, 3.8195268699907036`*^9}, 3.8195419286980686`*^9, {
   3.8196264482608285`*^9, 3.819626449906435*^9}},
 FontSize->11,ExpressionUUID->"8df85bc5-929f-4d11-823b-1aa7597da90c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SampleD", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"SampleD", ",", 
      RowBox[{
       SubscriptBox["A", "2"], "[", 
       RowBox[{"0.1", ",", "0.75"}], "]"}]}], "]"}], ",", "500"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.817636275932563*^9, 3.8176363410468097`*^9}, {
   3.817636371322134*^9, 3.817636379387992*^9}, {3.8177220227670016`*^9, 
   3.8177220245710535`*^9}, {3.817728705107853*^9, 3.81772870565835*^9}, 
   3.817905178514838*^9, 3.8179058993148274`*^9, {3.8180822568936925`*^9, 
   3.8180822569896913`*^9}, {3.8181624677912073`*^9, 3.81816246935386*^9}, {
   3.81884822866374*^9, 3.8188482407777095`*^9}, {3.818848714692604*^9, 
   3.81884872588339*^9}, {3.818848832165001*^9, 3.8188488325032964`*^9}, 
   3.818859529922344*^9, {3.8188644290464687`*^9, 3.818864429130968*^9}, 
   3.818955877895932*^9},
 FontSize->11,
 CellLabel->
  "In[566]:=",ExpressionUUID->"5c2a51d1-b40c-4074-9bff-b3ce61e4c026"],

Cell[TextData[{
 "The command below generates a matrix ",
 Cell[BoxData[
  FormBox["M1", TraditionalForm]],ExpressionUUID->
  "43a361ff-b156-4938-af7e-9d2a2a538aa0"],
 ", where entry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "8a800992-e8aa-4fee-80c2-8f769de92ca3"],
 " of the matrix in question yields the dynamical importance of node ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "146247ac-76c6-4004-89e7-956c9ba6d458"],
 " of the network corresponding to the adjacency matrix ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "f28a2807-da14-4fc5-8e41-ce227abeda5e"],
 " in SampleC:"
}], "Text",
 CellChangeTimes->{{3.8195269612631073`*^9, 3.819527095974038*^9}, {
  3.8195308964786386`*^9, 3.819530897910928*^9}, {3.819626461063553*^9, 
  3.8196264772362967`*^9}},
 FontSize->11,ExpressionUUID->"c29478be-b3df-4670-a4ea-abf2694a05fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["\[CapitalDelta]EvnC",
    FontWeight->"Bold"], "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", "=", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", "[", 
          RowBox[{"SampleC", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"f", "[", 
       RowBox[{
        RowBox[{"SampleC", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", "\[Lambda]"}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "SampleC", "]"}]}], "}"}]}], "]"}], ";", 
  RowBox[{"M1", "=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Re", "[", 
      StyleBox["\[CapitalDelta]EvnC",
       FontWeight->"Bold"], 
      StyleBox["]",
       FontWeight->"Bold"]}], 
     StyleBox[",",
      FontWeight->"Bold"], 
     StyleBox[
      RowBox[{"{", 
       RowBox[{"500", ",", "100"}], "}"}],
      FontWeight->"Bold"]}], 
    StyleBox["]",
     FontWeight->"Bold"]}]}], 
  StyleBox[";",
   FontWeight->"Bold"]}]], "Input",
 CellChangeTimes->{
  3.8194662598733587`*^9, 3.8194670684458704`*^9, {3.8194693774117346`*^9, 
   3.8194693775118504`*^9}, 3.819470763254321*^9},
 FontSize->11,
 CellLabel->
  "In[619]:=",ExpressionUUID->"606005ab-f7e0-48c2-8948-9a4e50dc433b"],

Cell[TextData[{
 "The command below now generates a plot which shows the relationship between \
the dynamical importance of a node and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["d", "k"], "in"], 
      SuperscriptBox[
       SubscriptBox["d", "k"], "out"]}], ")"}], 
    FractionBox["1", "2"]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "75a22c3e-926a-4e0d-af09-58b7485cc363"],
 " for networks in SampleC:"
}], "Text",
 CellChangeTimes->{{3.818951420834675*^9, 3.8189514473657494`*^9}, {
   3.819527960752942*^9, 3.819527961116149*^9}, 3.819528102730888*^9, {
   3.819528805287242*^9, 3.81952882095361*^9}, {3.8195301093925385`*^9, 
   3.819530110989391*^9}, {3.819541955108172*^9, 3.819541973670412*^9}, {
   3.8196403365675125`*^9, 3.8196403451226645`*^9}},
 FontSize->11,ExpressionUUID->"efd81517-751f-49ac-8a89-5548d9f7cf18"],

Cell[BoxData[
 RowBox[{
  RowBox[{"List1", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"T", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"SampleC", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}], 
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"SampleC", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
            FractionBox["1", "2"]], ",", 
           RowBox[{"-", 
            RowBox[{"M1", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "k"}], "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "100"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"List1", ",", "T"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "SampleC", "]"}]}], "}"}]}], "]"}], ";", 
  RowBox[{"L1", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"List1", ",", 
     RowBox[{"PlotRange", "\[Rule]", "Full"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Blue"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<(\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(in\)]\)\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(out\)]\)\!\(\*SuperscriptBox[\()\), FractionBox[\(1\), \(2\)]]\)\>\"", ",", 
        "\"\<\!\(\*SubscriptBox[\(I\), \(k\)]\)\>\""}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.8189516327292747`*^9, 3.818951642477216*^9}, {
   3.818954650426953*^9, 3.8189546504987392`*^9}, {3.8189574494381676`*^9, 
   3.818957461171816*^9}, {3.8190106658653297`*^9, 3.8190106682687597`*^9}, 
   3.8190107252113132`*^9, {3.8190107566696315`*^9, 3.8190108290953145`*^9}, {
   3.8190108622208195`*^9, 3.8190108741417956`*^9}, 3.8190132404359903`*^9, {
   3.8194693868893332`*^9, 3.8194693869582033`*^9}, {3.8194699735869865`*^9, 
   3.8194699760223875`*^9}, {3.8195251366405497`*^9, 3.819525149370578*^9}},
 FontSize->11,
 CellLabel->
  "In[699]:=",ExpressionUUID->"7f2a2fd0-9edf-4b4d-bbb7-26a8a227d0d8"],

Cell[TextData[{
 "Once again, the command below generates a matrix ",
 Cell[BoxData[
  FormBox["M2", TraditionalForm]],ExpressionUUID->
  "802d81a8-65af-4f43-ae77-5ff11a7d0590"],
 ", where entry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "c319a41d-41bc-4ec8-82cb-f1b20acab968"],
 " of the matrix in question yields the dynamical importance of node ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "57eca2b3-f765-4d83-885c-2fee76c33389"],
 " of the network corresponding to the adjacency matrix ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],ExpressionUUID->
  "44583be0-ae02-4660-80ed-66d00337c791"],
 " in SampleD:"
}], "Text",
 CellChangeTimes->{{3.819527104209777*^9, 3.819527121186265*^9}, {
  3.8195271553381553`*^9, 3.8195271556858573`*^9}, {3.819528994606944*^9, 
  3.819528995085621*^9}, {3.8195419969107747`*^9, 3.819542005406085*^9}, {
  3.8196265221701174`*^9, 3.8196265225401597`*^9}},
 FontSize->11,ExpressionUUID->"1e4efb94-77e3-421b-8f94-1396fdf793db"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["\[CapitalDelta]EvnD",
    FontWeight->"Bold"], "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", "=", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", "[", 
          RowBox[{"SampleD", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
