   3.8190177483303685`*^9, 3.819017759296712*^9}, {3.819211949113819*^9, 
   3.819211951572242*^9}, {3.819468880899011*^9, 3.8194688837183294`*^9}, {
   3.819469156691705*^9, 3.819469162562797*^9}, {3.819469511078588*^9, 
   3.819469511147562*^9}, {3.819469868230431*^9, 3.8194698731046667`*^9}, {
   3.8195253722391033`*^9, 3.819525381063855*^9}, {3.8195304536689653`*^9, 
