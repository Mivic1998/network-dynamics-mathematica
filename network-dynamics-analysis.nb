    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"CT1", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<t\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(WS, \*SubscriptBox[\(I\), \(k\
\)]\)]\)\>\""}], "}"}]}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"CT2", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<t\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(Tr, \*SubscriptBox[\(I\), \(k\
\)]\)]\)\>\""}], "}"}]}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"CT3", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<t\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(TS, \*SubscriptBox[\(I\), \(k\
\)]\)]\)\>\""}], "}"}]}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"CT4", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<t\>\"", ",", 
          "\"\<\!\(\*SubscriptBox[\(\[Rho]\), \(d, \*SubscriptBox[\(I\), \
\(k\)]\)]\)\>\""}], "}"}]}]}], "]"}]}], "}"}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.8193792975847597`*^9, 3.819379306414137*^9}, {
  3.8196220595129204`*^9, 3.8196221068911715`*^9}, {3.8196221375900664`*^9, 
