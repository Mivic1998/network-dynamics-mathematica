Cell[TextData[{
 "Note that for the higher value of ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "8f8cf59b-b66a-45a3-bd14-b493348237ff"],
 ", the ordering of nodes in terms of their dynamical importance is preserved \
to a far greater extent by equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "5", ")"}], TraditionalForm]],ExpressionUUID->
  "ffda43ec-b6e4-4450-93fa-c9b9c99d0883"],
 " than in the case where we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "0.1"}], TraditionalForm]],ExpressionUUID->
  "6b87d524-1afd-4427-8463-97af58644ba6"],
 ". This result is expected and validates our prior analysis, which put forth \
the idea that for small values of ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "8a52a750-f475-4ab9-a9b0-a0d95b12603a"],
 ", percentage differences in total degree across nodes are larger than for \
networks with high values of ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "57d60280-9150-481a-b6f8-498491a4f4ef"],
 ", which translates into large differences in eigenvector centralities \
across nodes for sufficiently small networks and, as a result, the violation \
of the condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox["v", "k"], 
      SubscriptBox["u", "k"]}], 
     RowBox[{"v", ".", "u"}]], 
    RowBox[{"<<", "1"}]}], TraditionalForm]],ExpressionUUID->
  "a9447804-dde3-45e3-9463-a29933cb58c1"],
 " for all ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "27a7dd58-0a92-457e-84f9-259b9f54f395"],
 " occurring with higher probability. Now, the command below generates a plot \
which shows the relationship between the dynamical importance of a node in \
the two networks generated and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["d", "k"], "in"], 
      SuperscriptBox[
       SubscriptBox["d", "k"], "out"]}], ")"}], 
    FractionBox["1", "2"]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d3bfc263-da31-45df-b2b1-0e7aa7597a44"],
 " for networks in SampleE. Note that, since the ordering of nodes in terms \
of their dynamical importance is preserved by equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", "5", ")"}], TraditionalForm]],ExpressionUUID->
  "8e78f29f-5668-4aee-a91c-d3edf8f6c984"],
 " for the sample of networks in SampleE, we can calculate the dynamical \
importance of each node directly from the equation in question, which is what \
we do below:"
}], "Text",
 CellChangeTimes->{{3.818953734740542*^9, 3.818953763847777*^9}, {
   3.819530191357031*^9, 3.819530200713463*^9}, {3.819530918855624*^9, 
   3.819530924116413*^9}, {3.8195401970180264`*^9, 3.819540295272484*^9}, {
   3.8195403845674386`*^9, 3.819540477810342*^9}, {3.819540512962528*^9, 
   3.81954052710513*^9}, {3.819541479529307*^9, 3.8195415348032875`*^9}, {
   3.819541589798148*^9, 3.819541659333104*^9}, {3.819542175389494*^9, 
   3.8195421869890003`*^9}, {3.819545104616408*^9, 3.8195451061031837`*^9}, {
   3.8196266782596407`*^9, 3.8196266869962735`*^9}, 3.8196406048778853`*^9, {
   3.819640637508649*^9, 3.819640647710362*^9}},
 FontSize->11,ExpressionUUID->"5290e7dd-96ad-4969-b0d0-ae80bf75a193"],

Cell[BoxData[
 RowBox[{
  RowBox[{"List3", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "=", 
       RowBox[{
        RowBox[{"Eigenvectors", "[", 
         RowBox[{"N", "[", 
          RowBox[{"SampleE", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"v", "=", 
       RowBox[{
        RowBox[{"Eigenvectors", "[", 
         RowBox[{"N", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"SampleE", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"T", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"SampleE", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}], 
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"SampleE", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ")"}], 
            FractionBox["1", "2"]], ",", 
           RowBox[{"Re", "[", 
            FractionBox[
             RowBox[{
              RowBox[{"u", "[", 
               RowBox[{"[", "k", "]"}], "]"}], 
              RowBox[{"v", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], 
             RowBox[{"u", ".", "v"}]], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "100"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"List3", ",", "T"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "SampleE", "]"}]}], "}"}]}], "]"}], ";", 
  RowBox[{"L3", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"List3", ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "100"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0.065"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", "Blue"}], ",", 
     RowBox[{"Frame", "\[Rule]", "True"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "\"\<(\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(in\)]\)\!\(\*SuperscriptBox[SubscriptBox[\(d\), \(k\)], \
\(out\)]\)\!\(\*SuperscriptBox[\()\), FractionBox[\(1\), \(2\)]]\)\>\"", ",", 
        "\"\<\!\(\*SubscriptBox[\(I\), \(k\)]\)\>\""}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.818953773448079*^9, 3.8189537886344843`*^9}, {
  3.8189575656036935`*^9, 3.8189575742176332`*^9}, {3.8189587635186663`*^9, 
  3.8189587665994344`*^9}, {3.81946883461763*^9, 3.819468842113179*^9}, {
  3.8194690825051117`*^9, 3.81946909473625*^9}, {3.8194698324106617`*^9, 
  3.819469835268484*^9}, {3.8195253436353207`*^9, 3.81952534951011*^9}, {
  3.8195254407116084`*^9, 3.8195254407806387`*^9}, {3.8195328979939833`*^9, 
  3.819532920034567*^9}, {3.819533613554596*^9, 3.8195336141080685`*^9}, {
  3.8195340667948847`*^9, 3.8195340710157223`*^9}, {3.819534832308943*^9, 
  3.8195348331101303`*^9}, {3.819542782067829*^9, 3.819542789125246*^9}, {
  3.8195433139670563`*^9, 3.8195433139983387`*^9}, {3.8196227305915527`*^9, 
  3.8196227308069754`*^9}},
 FontSize->11,
 CellLabel->
  "In[863]:=",ExpressionUUID->"bffe5194-45c7-4167-b9e6-a9a88a9e51f9"],

Cell[TextData[{
 "Meanwhile, the list SampleF below contains 500 adjacency matrices \
corresponding to networks of the the type ",
 Cell[BoxData[
  FormBox["A2", TraditionalForm]],ExpressionUUID->
  "1d8f53f7-9fbf-45d8-a3b1-f35c1067c1f8"],
 " with the parameters ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],ExpressionUUID->
  "a32509be-f74f-4c34-809a-48a7efe6216a"],
 " and ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]],ExpressionUUID->
  "be768e53-f693-4074-b46b-46914c641605"],
 " set to 0.9 and ",
 Cell[BoxData[
  FormBox["2", TraditionalForm]],ExpressionUUID->
  "83670028-c4a6-463c-8eaa-1018b63b07e5"],
 " respectively:"
}], "Text",
 CellChangeTimes->{{3.8189315799711423`*^9, 3.818931592008966*^9}, {
  3.819527240280796*^9, 3.819527259512437*^9}, {3.819540533630724*^9, 
  3.8195405355797653`*^9}, {3.8195406141911664`*^9, 3.819540615471117*^9}, {
  3.8195435819627314`*^9, 3.8195436016873007`*^9}},
 FontSize->11,ExpressionUUID->"5211a5fb-9aae-4893-930d-5e6a779ad875"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SampleF", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"SampleF", ",", 
      RowBox[{
       SubscriptBox["A", "2"], "[", 
       RowBox[{"0.9", ",", "2"}], "]"}]}], "]"}], ",", "500"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.818853652169961*^9, 3.818853652507229*^9}, {
  3.8188545690918975`*^9, 3.81885456940749*^9}, {3.8188569357518835`*^9, 
