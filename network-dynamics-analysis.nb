Cell[TextData[{
 "Finally, the command below generates a plot which shows the relationship \
between the dynamical importance of a node in the two networks generated and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       SubscriptBox["d", "k"], "in"], 
      SuperscriptBox[
       SubscriptBox["d", "k"], "out"]}], ")"}], 
    FractionBox["1", "2"]], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "d72b05ab-3c8c-432b-b8fc-6a57055dd9d0"],
 " for networks in SampleD:"
}], "Text",
 CellChangeTimes->{{3.818951550986805*^9, 3.8189515666179905`*^9}, {
  3.818957092991948*^9, 3.818957094895896*^9}, {3.8195288591096716`*^9, 
  3.8195288709619217`*^9}, {3.8195309049746103`*^9, 3.8195309054061193`*^9}, {
