Cell[TextData[{
 "We now check whether the block matrices ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "16a185cf-9985-47be-a954-7875f08ce912"],
 " and ",
 Cell[BoxData[
  FormBox["Y", TraditionalForm]],ExpressionUUID->
  "b181f049-78ed-4de9-8dbb-370b2c079238"],
 " that we have generated satisfy ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Y", "=", 
    SuperscriptBox["X", "T"]}], TraditionalForm]],ExpressionUUID->
  "ed65e5d3-603f-4a2f-881c-547b8f4904c7"],
 ":"
}], "Text",
 CellChangeTimes->{{3.8193050369703655`*^9, 3.8193050821335325`*^9}, {
  3.8196421177428775`*^9, 3.8196421209353065`*^9}},
 FontSize->11,ExpressionUUID->"6de7bda4-8db5-492a-bd60-c78694b51bb5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"BlockMatrix", "[", 
   RowBox[{"[", 
    RowBox[{
     RowBox[{"201", ";;", "400"}], ",", 
     RowBox[{"1", ";;", "200"}]}], "]"}], "]"}], "\[Equal]", 
  RowBox[{"Transpose", "[", 
   RowBox[{"BlockMatrix", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", ";;", "200"}], ",", 
      RowBox[{"201", ";;", "400"}]}], "]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.81930036251539*^9, 3.8193004127051067`*^9}},
 FontSize->11,
 CellLabel->
  "In[654]:=",ExpressionUUID->"740c2850-3f2f-4f98-a3da-9e6cd5c33c97"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.819300382754243*^9, 3.8193004145960517`*^9, 
  3.819473674810178*^9},
 FontSize->11,
 CellLabel->
  "Out[654]=",ExpressionUUID->"7dfcc6c7-320e-41a7-bfe2-e290c20aecbd"]
}, Open  ]],

Cell[TextData[{
 "Thus we see that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Y", "=", 
    SuperscriptBox["X", "T"]}], TraditionalForm]],ExpressionUUID->
  "0de2c43b-b6ed-4ade-af6e-db2a28e6e8aa"],
 " holds. Now, the first two elements of the list below count the number of \
non-zero elements of the two block matrices on the diagonal of the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", ".", "B1", ".", 
    SuperscriptBox["P", "T"]}], TraditionalForm]],ExpressionUUID->
  "07a54054-7445-48fb-a5ee-e10553f758cd"],
 ". Meanwhile, the third element of the list below yields the number of \
columns of ",
 Cell[BoxData[
  FormBox["Y", TraditionalForm]],ExpressionUUID->
  "376e5fc1-114f-4a23-9109-0ac72362d724"],
 " which consist only of zeroes (which is equal to the number of rows of ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "04442258-bb9a-4a81-8213-3b355e7e40c6"],
 " that consist only of zeroes). Meanwhile, the fourth element of the list \
below yields the number of columns of ",
 Cell[BoxData[
  FormBox["X", TraditionalForm]],ExpressionUUID->
  "2cd9a8f8-37b3-4de2-ba4c-f553ad4bdd99"],
 " which consist only of zeroes. Now, we have constructed the permutation \
correctly if and only if all four elements of the list below are zero:"
}], "Text",
