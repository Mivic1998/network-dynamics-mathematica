   3.8196409854995823`*^9, 3.8196409883968244`*^9}, 3.819641055556198*^9, {
   3.819641167375126*^9, 3.819641168217873*^9}},
 FontSize->11,ExpressionUUID->"057f734b-00c7-4863-86b4-aeae337dd8b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"C2", "=", 
   RowBox[{
    SubscriptBox["A", "2"], "[", 
    RowBox[{"0.9", ",", 
     RowBox[{"-", "10"}]}], "]"}]}], ";", 
  RowBox[{
   SubscriptBox["\[Alpha]", "3"], "=", 
   RowBox[{
    RowBox[{"Eigenvalues", "[", 
     RowBox[{"N", "[", "A4", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
  RowBox[{
   StyleBox["\[CapitalDelta]EvnG",
    FontWeight->"Bold"], "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"f", "[", 
   RowBox[{"A4", ",", 
    SubscriptBox["\[Alpha]", "3"]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8189561635682936`*^9, 3.8189561853560905`*^9}, {
