   3.8168648701486907`*^9}, 3.8168651661083965`*^9, 3.818184174282371*^9, {
   3.9987358057103043`*^9, 3.998735806894619*^9}, {3.998736117690262*^9, 
   3.9987361273038425`*^9}, {3.9987400168880424`*^9, 3.9987400179591465`*^9}},
 TextJustification->0.,
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"284d4af7-0bff-4ade-925d-1fcda24d034d"],

Cell[TextData[{
 "The command below takes the component ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "7125f389-f181-4f78-a059-c21b93717773"],
 " of an adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "dc995269-c80d-4a12-9d6d-a3d2b56743a9"],
 " and generates a new matrix with the same dimensions that has all entries \
equal to zero other than the entry ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "77691611-6f27-4887-a2a6-f07c77574886"],
 ", which takes a value of ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "07d74f8e-5819-4e9a-9dc3-825e7f10bb11"],
 " if the component ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "90561326-0fc9-4561-b3bb-2c0f062889ce"],
 " of the original matrix takes value ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "0c079f12-b80a-40c8-b939-8f5036a01ac3"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", "1"}], TraditionalForm]],ExpressionUUID->
  "9748f757-70ae-4956-819c-153273af3888"],
 " if the component ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"i", ",", "j"}], ")"}], TraditionalForm]],ExpressionUUID->
  "776d7f32-e789-4986-b04f-d1bb05181493"],
 " of the original matrix takes a value of ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "9650bc39-d694-4cac-b708-18d7cc79d29e"],
 "."
}], "Text",
 CellChangeTimes->{{3.819285883385672*^9, 3.819285920304926*^9}, {
  3.8192859630555153`*^9, 3.819285970080721*^9}, {3.8192860360883613`*^9, 
  3.8192860911191626`*^9}, {3.819286160386799*^9, 3.819286190837332*^9}, {
  3.8192862511120634`*^9, 3.8192864523695965`*^9}, {3.8196386778919835`*^9, 
  3.8196386799724193`*^9}},
 FontSize->11,ExpressionUUID->"37bdda6a-bf2d-4dd1-9a9b-388822f91b81"],

Cell[BoxData[
 RowBox[{
  RowBox[{"R", "[", 
   RowBox[{"A_", ",", "i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"A", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", "1"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "\[Equal]", "i"}], " ", "&&", " ", 
         RowBox[{"l", "\[Equal]", "j"}]}], ",", 
        RowBox[{"-", "1"}], ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", 
        RowBox[{"Length", "[", "A", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", 
        RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "\[Equal]", "i"}], " ", "&&", " ", 
         RowBox[{"l", "\[Equal]", "j"}]}], ",", "1", ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", 
        RowBox[{"Length", "[", "A", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", 
        RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8174669313481765`*^9, 3.817466938856513*^9}, {
  3.817467016640067*^9, 3.8174670336877317`*^9}, {3.8174670644802637`*^9, 
  3.817467088535582*^9}, {3.8174698252740526`*^9, 3.817469854142771*^9}, {
  3.8174739846561975`*^9, 3.8174739975260754`*^9}, {3.8174740821158056`*^9, 
  3.8174740866276417`*^9}, {3.8192859868079653`*^9, 3.8192860031115904`*^9}, {
  3.8192861254283304`*^9, 3.8192861322192*^9}},
 FontSize->11,
 CellLabel->
  "In[540]:=",ExpressionUUID->"a2fe2427-e04b-4d2d-b9db-27965720eb6b"],

Cell[TextData[{
 "Now, the Do command below takes a component of an adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "9fb6cfd4-d9a0-41ff-9a8b-854ea2ce4225"],
 " and replaces it with ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "d264d9f3-4c6a-47ca-a379-42e9ed4f44a1"],
 " if the original entry was ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "fc2ab732-c391-48f0-a448-de4b5446175d"],
 " (which represents the removal of a link if it exists) and with ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "a4b32b12-abfc-4a0b-8f85-20ae3759185c"],
 " if the original entry was ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "aac085de-646e-4e38-b840-c82afe167849"],
 " (which represents the addition of a link if it doesn\[CloseCurlyQuote]t \
exist) by adding the output of the command ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "1cb3500a-3751-41cc-adbc-3f11a11fe7b7"],
 " for the component in question to the original adjacency matrix. The \
command then calculates the relative change in the largest eigenvalue with \
respect to the original adjacency matrix for this new adjacency matrix \
(called ",
 Cell[BoxData[
  FormBox["B", TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "416fe2e3-fa1b-4ee1-86ac-fa37ae646417"],
 "), and appends the result to the list \[CapitalDelta]Evl. It does this for \
all components of the original adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "27308a0f-ad06-47c2-a7ff-07fbcd897e52"],
 ". Note that element ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],ExpressionUUID->
  "0d9ad524-b24f-4fbd-90a5-0316894198fa"],
 " of the list \[CapitalDelta]Evl corresponds to the relative change in the \
value of the largest eigenvalue when we add/remove the link ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Ceiling", "[", 
     FractionBox["k", "100"], "]"}], "\[Rule]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       FractionBox["k", "100"], "\[Element]", "Integers"}], ",", "100", ",", 
      RowBox[{"k", "-", 
       RowBox[{"100", " ", 
        RowBox[{"Floor", "[", 
         FractionBox["k", "100"], "]"}]}]}]}], "]"}]}], TraditionalForm]],
  ExpressionUUID->"ad8a2358-d779-4529-b0fb-7651fbd77e19"],
 " from the network represented by the original adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "15296ba1-6ef7-4343-914d-a8c77021191e"],
 ". Note that in order to maximise the speed of the calculation described, we \
have written the function ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "7d138138-cb04-46bf-a519-e3122239b636"],
 " below so that the largest eigenvalue of the original matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "92c84be6-dbb3-40f2-b636-5413d570c7ed"],
 " is specified as an input, which prevents the Do command from having to \
recalculate the eigenvalue in question for each of its iterations.   "
}], "Text",
 CellChangeTimes->{{3.819286473865085*^9, 3.81928648349436*^9}, {
  3.819286550875045*^9, 3.8192865514485135`*^9}, {3.8192866311512957`*^9, 
  3.8192866569582186`*^9}, {3.8192869391861157`*^9, 3.8192869722018166`*^9}, {
  3.819287002233431*^9, 3.819287012451095*^9}, {3.8192870626537757`*^9, 
  3.819287499704441*^9}, {3.8192875352682896`*^9, 3.819287670802706*^9}, {
  3.8192877377186356`*^9, 3.81928787765224*^9}, {3.8192879512204065`*^9, 
  3.8192880991885157`*^9}, {3.8192882495043445`*^9, 3.8192883383885345`*^9}, {
  3.81928882984464*^9, 3.8192888976033497`*^9}, {3.819289079859756*^9, 
  3.819289081033617*^9}, {3.819289137669074*^9, 3.819289141102867*^9}, {
  3.8192896728471766`*^9, 3.819289730104983*^9}, {3.819289866569906*^9, 
  3.8192898672789736`*^9}, {3.819625105919032*^9, 3.8196251384360723`*^9}, {
  3.8196387417831326`*^9, 3.8196387447651215`*^9}},
 FontSize->11,ExpressionUUID->"0d1e09a7-ff14-4cbc-ba85-615b63e0629c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"d", "[", 
    RowBox[{"A_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"B", "=", 
        RowBox[{"A", "+", 
         RowBox[{"R", "[", 
          RowBox[{"A", ",", "i", ",", "j"}], "]"}]}]}], ",", 
       RowBox[{"\[Mu]", "=", 
        RowBox[{
         RowBox[{"Eigenvalues", "[", "B", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{
         StyleBox["\[CapitalDelta]Evl",
          FontWeight->"Bold"], ",", 
         FractionBox[
          RowBox[{"\[Mu]", "-", "\[Lambda]"}], "\[Lambda]"]}], "]"}]}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "A", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.8174983051233463`*^9, 3.817498305272941*^9}, {
   3.8175060684112597`*^9, 3.8175060712376633`*^9}, {3.8181632086338797`*^9, 
