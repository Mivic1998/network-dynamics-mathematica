Cell[CellGroupData[{

Cell[TextData[{
 "        ",
 StyleBox["Parameter Sensitivity",
  FontSize->20,
  FontColor->RGBColor[0.5019607843137255, 0., 0.]]
}], "Subtitle",
 CellChangeTimes->{{3.99873599441947*^9, 3.9987360132956295`*^9}, {
   3.998736774204769*^9, 3.998736781549732*^9}, 
   3.9987451030706787`*^9},ExpressionUUID->"48654c45-d1d1-b24a-be03-\
41145549c931"],

Cell["\<\
I test whether the preceding results are representative by repeating the \
analysis across samples of randomly generated networks. I then vary network \
density and the spatial-network parameters to investigate how assortativity \
and network structure affect the relationship between node degree, dynamical \
importance and the accuracy of the theoretical approximation.\
\>", "Text",
 CellChangeTimes->{{3.598452093952716*^9, 3.598452204485716*^9}, {
   3.652420633161273*^9, 3.6524206868278103`*^9}, {3.652420752564468*^9, 
