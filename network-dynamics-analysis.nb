Cell[TextData[{
 "The following command generates an adjacency matrix for an \
Erdos-R\[EAcute]nyi network consisting of 100 nodes with no self-loops in \
which the probability of any link ",
 Cell[BoxData[
  FormBox[
   FormBox[
    RowBox[{"i", "\[Rule]", "j"}],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "ecc139e1-4907-4fb5-aa0f-ab113c680752"],
 " existing, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[NotEqual]", "j"}], TraditionalForm]],ExpressionUUID->
  "8b2a7341-09eb-4fe8-a8f3-827a0608a174"],
 ", is given by ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FontSize->11,ExpressionUUID->"94502498-e499-4424-8727-1cac054265d0"],
 ":"
}], "Text",
 CellChangeTimes->{{3.8192736552959833`*^9, 3.8192737292722816`*^9}, {
  3.81937598509657*^9, 3.8193759860889134`*^9}, {3.819636763711635*^9, 
  3.81963682839264*^9}},
 FontSize->11,ExpressionUUID->"96845205-11f6-40ad-9706-ce44bb7770ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["A", "1"], "[", 
   RowBox[{"p_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"i", "\[Equal]", "j"}], ",", "0", ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"RandomReal", "[", "]"}], "<", "p"}], ",", "1", ",", "0"}], 
       "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.817330282674548*^9, 3.8173302889557505`*^9}, {
  3.817505896664047*^9, 3.817505918461836*^9}, {3.8177219354005384`*^9, 
  3.817721935503232*^9}},
 FontSize->11,
 CellLabel->"In[1]:=",ExpressionUUID->"3f2d62fc-1ee1-47e3-8183-42b4179d284d"],

Cell[TextData[{
 "Meanwhile, the following command generates a list of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FontSize->11,ExpressionUUID->"85f55f40-284a-44c1-a8e1-c6acf2a2e0bc"],
 " points in a two-dimensional space named Nodes, where the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"f1738720-18fc-4e46-97a3-1d787fb71fcb"],
 " coordinate of each point is initially drawn from a uniform distribution on \
the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "10"}], "]"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"3fc87855-00c2-482b-9d7f-1cd9816e4fe0"],
 " and the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"307b6206-0d34-45b8-9554-36815b432533"],
 " coordinate is then drawn from a normal distribution such that the expected \
value of ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"06447268-d0ea-4da6-8d56-86d89a9153d8"],
 " for a point with ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"03a76c04-a10b-4fb6-9f26-518c3823cc7b"],
 " coordinate given by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "*"], TraditionalForm]],
  FontSize->11,ExpressionUUID->"bb96e316-57da-42f1-9edb-fcbca219ba0c"],
 " is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"10", "-", 
    SuperscriptBox["x", "*"]}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"80834fb2-0439-48f0-b7c8-3ec3701f6b6f"],
 ", while the standard deviation for the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"7a567305-aa8f-44a1-a7dd-5f7ec9ec6030"],
 " coordinate is given by ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Alpha]", 
    SuperscriptBox["\[Beta]", 
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"5", "-", 
       SuperscriptBox["x", "*"]}], "\[RightBracketingBar]"}]]], 
   TraditionalForm]],
  FontSize->11,ExpressionUUID->"477b6fa6-dbfd-4e12-be88-f061641f2bfc"],
 ", where \[Alpha] and  \[Beta] require specification:"
}], "Text",
 CellChangeTimes->{{3.819273747710486*^9, 3.819273781357397*^9}, {
  3.8192738148256435`*^9, 3.8192738255596623`*^9}, {3.819273857555458*^9, 
  3.819273969446906*^9}, {3.8192740059747705`*^9, 3.819274021191077*^9}, {
  3.819274066430334*^9, 3.8192741231907935`*^9}, {3.8192741654415617`*^9, 
  3.8192743391984067`*^9}, {3.8192743781728725`*^9, 3.819274408150381*^9}, {
  3.819275656098488*^9, 3.8192757490610948`*^9}, {3.819278839059324*^9, 
  3.8192788393485265`*^9}, {3.8196241307721663`*^9, 3.819624147114458*^9}, {
  3.819624188106819*^9, 3.8196241912115145`*^9}},
 FontSize->11,ExpressionUUID->"18fb57c9-a350-4ab7-9233-b42978a7b33b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Y", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "=", 
       RowBox[{"{", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "10"}], "}"}], "]"}], "}"}]}], ",", 
      RowBox[{"y", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{
          RowBox[{"10", "-", 
           RowBox[{"x", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"\[Alpha]", 
           FractionBox["1", 
            SuperscriptBox["\[Beta]", 
             RowBox[{"Abs", "[", 
              RowBox[{"5", "-", 
               RowBox[{"x", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}]]]}]}], "]"}], "]"}]}],
       ",", 
      RowBox[{"z", "=", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"Nodes", ",", "z"}], "]"}]}], "}"}], ",", "n"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.817631669050831*^9, 3.81763168449809*^9}, {
  3.817631801034793*^9, 3.8176318140792933`*^9}, {3.8176318543048415`*^9, 
  3.8176318903415117`*^9}, {3.8176319412176332`*^9, 3.817631991915521*^9}, {
  3.817632028135743*^9, 3.817632120602167*^9}, {3.8176321522215967`*^9, 
  3.8176321551735926`*^9}, {3.8176321892343764`*^9, 3.8176322676557727`*^9}, {
  3.81772863159233*^9, 3.8177286529941235`*^9}},
 FontSize->11,
 CellLabel->"In[2]:=",ExpressionUUID->"624bc46e-a6f1-43e7-b14e-d0644b3d657d"],

Cell[TextData[{
 "Note that for large \[Beta], as the value of the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"8aa0e9b7-5c4e-4d62-9c84-2ffd473b7ad5"],
 " coordinate deviates away from the ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]],
  FontSize->11,ExpressionUUID->"4759c0a8-d2bc-4fbb-ad41-845594cde3ef"],
 ", the standard deviation of the normal distribution from which the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"ee0758d4-95b3-45ef-889a-f6d69eae3d5e"],
 " coordinate is drawn approaches zero and its value converges to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", "x"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"4b632690-95fd-4048-8a2f-7faaf156aee3"],
 ", which ensures that for extreme values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"b409e494-0c3a-408e-bc49-1f78580d6331"],
 ", the value of ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"32d4c9a1-ecad-450f-bbce-acc49968fe65"],
 " remains on the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "10"}], "]"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"87776189-11db-4bc9-8587-9becf44abf7b"],
 " for sufficiently large \[Beta]. Note also that the larger is the value of \
\[Beta], the more rapidly the value of ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"0860534b-c38d-4c94-b5d5-f530fe772c94"],
 " converges to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", "x"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"717f64f4-9712-4113-86d4-bfaffa53e557"],
 " as we deviate from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"76e9c147-63de-4c3a-8a5f-8fce9a97fe73"],
 ". Meanwhile, note that for ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"d6b81493-7160-479a-b493-c75f51a28cdf"],
 " very close to ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]],
  FontSize->11,ExpressionUUID->"78d6f004-de3c-4320-8ff7-6512817a170f"],
 ", the standard deviation of the distribution for ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->"TraditionalForm",
  FontSize->11,ExpressionUUID->"34e607a8-f810-4c6b-b0f8-23897bcfddf2"],
 " is given by approximately ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FontSize->11,ExpressionUUID->"d60a16b4-a0f8-4cbe-8e3c-129073b22729"],
 " which is independent of the value of \[Beta]. Thus, the larger the value \
of ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FontSize->11,ExpressionUUID->"783efd32-9040-43b9-aa71-e00f999d6fdb"],
 ", the greater is the variance of ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->"TraditionalForm",
  FontSize->11,ExpressionUUID->"6e6312f5-1b03-4861-825c-4a005ba6d7c9"],
 " for points with ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"c4687b32-50dc-450b-a735-94212266fe79"],
 " close to ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]],
  FontSize->11,ExpressionUUID->"80c5eafa-3ed8-4e56-9464-b7191186e7a6"],
 ", which will result in the average distance between such points increasing. \
Now, the command ",
 Cell[BoxData[
  FormBox["GD", TraditionalForm]],
  FontSize->11,ExpressionUUID->"6beb4db8-8127-4dcb-a687-c3fbd906cce2"],
 " below allows us to compute the geometric distance between any two points \
that belong to Nodes, while the command ",
 Cell[BoxData[
  FormBox["SW", TraditionalForm]],
  FontSize->11,ExpressionUUID->"f1d47cf2-d330-4a52-95c4-065d2114dda6"],
 " simply takes GD to the power ",
 Cell[BoxData[
  FormBox["\[Gamma]", TraditionalForm]],
  FontSize->11,ExpressionUUID->"d853ed16-17e6-4885-b626-ff671df89c6b"],
 ", where \[Gamma] requires specification:"
}], "Text",
 CellChangeTimes->{{3.8192758037881994`*^9, 3.8192758832324457`*^9}, {
  3.819275927100545*^9, 3.8192759887458124`*^9}, {3.819276263036003*^9, 
  3.8192762630370007`*^9}, {3.8192788449725046`*^9, 3.819278940969637*^9}, {
  3.8192797458860693`*^9, 3.8192797992443085`*^9}, {3.8192798388164473`*^9, 
  3.819279839222346*^9}, {3.8192800022441807`*^9, 3.81928011561386*^9}, {
  3.8192801571477346`*^9, 3.8192802724701943`*^9}, {3.819280431471778*^9, 
  3.8192805723698044`*^9}, {3.8192806170153537`*^9, 3.81928067683335*^9}, {
  3.8196242664602647`*^9, 3.819624326251337*^9}},
 FontSize->11,ExpressionUUID->"941b2371-599b-4c09-ad0f-39358c1dd922"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GD", "[", 
    RowBox[{"Label1_", ",", "Label2_"}], "]"}], ":=", 
   RowBox[{
    SqrtBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Label1", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{"Label2", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "2"]], "+", 
    SqrtBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Label1", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"Label2", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"]]}]}], ";", 
  RowBox[{
   RowBox[{"SW", "[", 
    RowBox[{"Label1_", ",", "Label2_", ",", "\[Gamma]_"}], "]"}], ":=", " ", 
   SuperscriptBox[
    RowBox[{"GD", "[", 
     RowBox[{"Label1", ",", "Label2"}], "]"}], "\[Gamma]"]}]}]], "Input",
 CellChangeTimes->{{3.8176328826266613`*^9, 3.817633140615346*^9}, {
   3.817636939894616*^9, 3.817636940435253*^9}, {3.8192757790174665`*^9, 
   3.819275781317315*^9}, 3.819276265858492*^9, 3.8192763409538746`*^9},
 FontSize->11,
 CellLabel->"In[3]:=",ExpressionUUID->"9ffa8145-d5e4-4317-8fa3-28f4a49c0c60"],

Cell[TextData[{
 "The command below generates an adjacency matrix for a network with no \
self-loops where the probability that the link ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[Rule]", "j"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"b277658b-6225-40ba-b6cc-5eb430a8ec5c"],
 " exists for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[NotEqual]", "j"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"43882dbc-f741-4c4a-b65e-8994cd0f3a67"],
 " is given by ",
 Cell[BoxData[
  FormBox[
   FractionBox["p", 
    RowBox[{"Max", "[", 
     RowBox[{"1", ",", 
      SuperscriptBox[
       RowBox[{"D", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "\[Gamma]"]}], "]"}]], 
   TraditionalForm]],
  FontSize->11,ExpressionUUID->"7e50045a-b5b0-42bd-a22d-7e1b0119627e"],
 ", with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"D", "[", 
    RowBox[{"i", ",", "j"}], "]"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"6ba1c004-6f3d-4d40-9e1b-d49ae0c44f75"],
 " being the geometric distance between the points representing the nodes ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FontSize->11,ExpressionUUID->"0bcd4159-5aa9-43dd-a068-1e588cadd979"],
 " and ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],
  FontSize->11,ExpressionUUID->"62619b51-3228-4bbe-ab5e-4d2003a723de"],
 ":"
}], "Text",
 CellChangeTimes->{{3.8176360312942033`*^9, 3.8176361808268194`*^9}, {
  3.819276010208211*^9, 3.8192760267259297`*^9}, {3.81927606062026*^9, 
  3.8192760667947483`*^9}, {3.81927610424517*^9, 3.8192761664632344`*^9}, {
  3.81927621305315*^9, 3.8192762564617386`*^9}, {3.819276346329492*^9, 
  3.8192764004193697`*^9}, {3.8192764789586596`*^9, 3.81927665995844*^9}, {
  3.819276821226439*^9, 3.8192768495029964`*^9}, {3.8196243492049456`*^9, 
  3.819624350883456*^9}, {3.8196367368764453`*^9, 3.8196367428075476`*^9}},
 FontSize->11,ExpressionUUID->"09ffff7a-0c65-48ba-ae41-28da0b9948c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["A", "2"], "[", 
   RowBox[{"p_", ",", "\[Gamma]_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"i", "\[Equal]", "j"}], ",", "0", ",", 
      RowBox[{"RandomChoice", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox["p", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"SW", "[", 
              RowBox[{
               RowBox[{"Nodes", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"Nodes", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", "\[Gamma]"}], "]"}], ",",
              "1"}], "]"}]], ",", 
          RowBox[{"1", "-", 
           FractionBox["p", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"SW", "[", 
               RowBox[{
                RowBox[{"Nodes", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", 
                RowBox[{"Nodes", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", "\[Gamma]"}], "]"}], 
              ",", "1"}], "]"}]]}]}], "}"}], "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "Nodes", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", 
      RowBox[{"Length", "[", "Nodes", "]"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.817633404610462*^9, 3.817633494208129*^9}, {
  3.8176346306589403`*^9, 3.8176346795336175`*^9}, {3.817634719332121*^9, 
  3.8176347727671843`*^9}, {3.817635200593046*^9, 3.817635219754033*^9}, {
  3.8176352642016563`*^9, 3.817635536687969*^9}, {3.81763565412671*^9, 
  3.817635658245476*^9}, {3.8176357530497055`*^9, 3.8176358429881787`*^9}, {
  3.817636815864769*^9, 3.8176368395590305`*^9}, {3.8180820320360456`*^9, 
  3.818082032136273*^9}, {3.818695348628133*^9, 3.8186953638743467`*^9}, {
  3.8192768254760323`*^9, 3.8192768286894703`*^9}},
 FontSize->11,
 CellLabel->"In[4]:=",ExpressionUUID->"67484879-288c-40f7-a69c-6c1ea97bf86b"],

Cell[TextData[{
 "Note that the probability that the link ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[Rule]", "j"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"4932f118-4f36-48bf-ac24-5ecdc766bb80"],
 " exists is equal to the probability that the link ",
 Cell[BoxData[
  FormBox[
   RowBox[{"j", "\[Rule]", "i"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"8bcc7500-0ab5-4dc0-94b0-79184c01ec93"],
 " exists, so that the adjacency matrix corresponding to such a network is \
symmetric in expectation.\n"
}], "Text",
 CellChangeTimes->{{3.819283064567462*^9, 3.819283151708302*^9}, {
   3.8196369145043693`*^9, 3.8196369168062124`*^9}, 3.9987368501879005`*^9},
 FontSize->11,ExpressionUUID->"373b9219-74d7-4936-a735-208f349126af"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "     ",
 StyleBox["   ",
  FontSize->20],
 StyleBox["Repeated Network Simulations",
  FontSize->20,
  FontColor->RGBColor[0.5019607843137255, 0., 0.]]
}], "Subtitle",
 CellChangeTimes->{{3.998733589177101*^9, 3.9987336072455235`*^9}, {
   3.9987368517906017`*^9, 3.998736853276802*^9}, 
   3.998744652603113*^9},ExpressionUUID->"cb01d2ee-4d94-5f43-bb6a-\
4a69ca286f7c"],

Cell["\<\
To compare the statistical properties of the two network models, I generate \
repeated samples of networks using fixed parameter values. Node positions are \
regenerated for each spatial network so that the results capture variation in \
both network connections and the underlying spatial distribution of nodes.\
\>", "Text",
 CellChangeTimes->{{3.598452093952716*^9, 3.598452204485716*^9}, {
   3.652420633161273*^9, 3.6524206868278103`*^9}, {3.652420752564468*^9, 
   3.6524207756666994`*^9}, {3.6524208270572195`*^9, 3.652420860190551*^9}, {
   3.6524210786297*^9, 3.6524210940307*^9}, {3.652967960434185*^9, 
   3.652968115298876*^9}, {3.6529733486104965`*^9, 3.6529733896518383`*^9}, {
   3.683718120594956*^9, 3.683718123730938*^9}, {3.6837181586916018`*^9, 
   3.683718175369363*^9}, {3.6837741655485477`*^9, 3.683774166986993*^9}, {
   3.683774748963084*^9, 3.683774773993095*^9}, {3.683774831383595*^9, 
   3.68377486405478*^9}, {3.683774918249523*^9, 3.683774954160534*^9}, {
   3.6845117734469385`*^9, 3.684511835768572*^9}, 3.6845119826187377`*^9, {
   3.6846037549010444`*^9, 3.6846038176765676`*^9}, {3.6851288323337092`*^9, 
   3.6851291036115475`*^9}, {3.6851297173722887`*^9, 3.685129718458522*^9}, {
   3.6851314218370667`*^9, 3.685131447867895*^9}, {3.685131509731413*^9, 
   3.685131517663705*^9}, {3.685185089630221*^9, 3.6851852810272207`*^9}, {
   3.697183568757872*^9, 3.697183594886485*^9}, {3.7472105780738697`*^9, 
   3.7472105832291517`*^9}, {3.753013281511385*^9, 3.7530133238314266`*^9}, {
   3.753013729293499*^9, 3.7530137773346033`*^9}, {3.753013815932062*^9, 
   3.7530139762751236`*^9}, {3.753014067140837*^9, 3.753014068139863*^9}, {
   3.753014114597804*^9, 3.7530142710179152`*^9}, {3.7530144253634095`*^9, 
   3.753014429107126*^9}, {3.7530147773772297`*^9, 3.7530147774645844`*^9}, {
   3.755154789567511*^9, 3.755154859269661*^9}, {3.7680401569374084`*^9, 
   3.768040157385848*^9}, {3.7680402358806114`*^9, 3.7680402373383317`*^9}, {
   3.77495920130507*^9, 3.7749597620291457`*^9}, {3.77513286750156*^9, 
   3.775132898021247*^9}, {3.778866087425239*^9, 3.778866259527502*^9}, {
   3.778866295466211*^9, 3.7788664058104787`*^9}, {3.8014866697031603`*^9, 
   3.8014866716380296`*^9}, {3.801486916405057*^9, 3.801486975596875*^9}, {
   3.801487017370192*^9, 3.801487047063816*^9}, {3.8014871633479366`*^9, 
   3.801487181410654*^9}, {3.801487215713957*^9, 3.80148721859031*^9}, {
   3.8014877143143015`*^9, 3.8014880032888165`*^9}, {3.8014882268073134`*^9, 
   3.8014882413764153`*^9}, {3.8033793583540897`*^9, 
   3.8033794273583603`*^9}, {3.8033796228154287`*^9, 3.803379640089072*^9}, {
   3.8033805615415697`*^9, 3.803380646874024*^9}, {3.803630406717191*^9, 
   3.8036304192536693`*^9}, {3.803630518297773*^9, 3.803630518609902*^9}, {
   3.8036305600929832`*^9, 3.8036305600929832`*^9}, {3.8036307783781133`*^9, 
   3.8036308606011815`*^9}, {3.8053681946307354`*^9, 
   3.8053682120110083`*^9}, {3.8053682718437815`*^9, 
   3.8053683269435396`*^9}, {3.8053683619824047`*^9, 3.805368707126303*^9}, {
   3.80536876819514*^9, 3.8053688654388213`*^9}, {3.805368933520688*^9, 
   3.805368980534671*^9}, {3.8053690139001265`*^9, 3.8053691639045515`*^9}, {
   3.8053692441480365`*^9, 3.80536931864217*^9}, {3.8168635272309895`*^9, 
   3.8168635845935636`*^9}, {3.816863685372053*^9, 3.81686375134494*^9}, {
   3.81686388120994*^9, 3.816863947167095*^9}, {3.816863997606894*^9, 
   3.816864003864453*^9}, {3.8168640429415116`*^9, 3.8168641026916676`*^9}, {
   3.816864152463027*^9, 3.8168641981214075`*^9}, {3.816864244975381*^9, 
   3.816864402502413*^9}, {3.8168644747157183`*^9, 3.8168645079661427`*^9}, {
   3.81686457124308*^9, 3.8168645975993056`*^9}, {3.8168652911906524`*^9, 
   3.816865293077902*^9}, {3.81686567594371*^9, 3.8168656761610785`*^9}, 
   3.8168676588086147`*^9, {3.816867705329894*^9, 3.816867706484769*^9}, {
   3.998732865209482*^9, 3.9987329004359665`*^9}, {3.998733609648182*^9, 
   3.998733612669777*^9}, {3.998736085288719*^9, 3.998736095989355*^9}, {
   3.99874002892873*^9, 3.998740030085787*^9}},
 TextJustification->0.,
 Background->RGBColor[
  1, 0.9, 0.8],ExpressionUUID->"3a94d436-b48a-41e7-b5ec-e58e49f923a4"],

Cell[TextData[{
 "The command below generates a sample of ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],
  FontSize->11,ExpressionUUID->"fb131bbb-6bde-4bc7-afb7-cc3bcae00c2b"],
 " adjacency matrices corresponding to Erdos-R\[EAcute]nyi networks with no \
self-loops and consisting of ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],
  FontSize->11,ExpressionUUID->"3be47ade-afd0-4134-82f8-69e890fe1fb2"],
 " agents, where each link  ",
 Cell[BoxData[
  FormBox[
   FormBox[
    RowBox[{"i", "\[Rule]", "j"}],
    TraditionalForm], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "0799708c-ed9f-4a63-9192-bc57c3606a53"],
 " satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{"i", "\[NotEqual]", "j"}], TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "7910920b-338f-411b-b1b6-df2091cc9629"],
 " has probability ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]],
  FontSize->11,ExpressionUUID->"c2f2f602-bab2-4190-b441-25774c7fbba4"],
 " of existing:"
}], "Text",
 CellChangeTimes->{{3.8192768671316533`*^9, 3.819276954810687*^9}, {
  3.819624383440379*^9, 3.81962438384729*^9}, {3.8196370299874973`*^9, 
  3.819637079937936*^9}},
 FontSize->11,ExpressionUUID->"62a31c97-dc6a-40df-b3d1-af0b8c2d9a63"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sample", "[", 
   RowBox[{"p_", ",", "n_", ",", "M_"}], "]"}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["A", "1"], "[", 
     RowBox[{"p", ",", "n"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "M"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.817721660959521*^9, 3.817721699049657*^9}, {
  3.817721882440447*^9, 3.817721898623103*^9}, {3.817721947583881*^9, 
  3.8177219699561377`*^9}, {3.818082216926936*^9, 3.8180822170070906`*^9}, {
  3.8188482907838483`*^9, 3.8188483214370584`*^9}},
 FontSize->11,
 CellLabel->"In[5]:=",ExpressionUUID->"fe8b6f23-53a3-4cb0-85bd-c5a6ed3203c4"],

Cell[TextData[{
 "We now generate a sample of ",
 Cell[BoxData[
  FormBox["10000", TraditionalForm]],
  FontSize->11,ExpressionUUID->"f02ef48b-fdf3-4388-bce0-4c310799c34a"],
 " such networks satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "0.1"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"cd000360-476a-4812-92f2-3eafa4ce33fc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "100"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"ea549252-ddb9-4f77-ad65-2f8ff0ebe0d2"],
 ":"
}], "Text",
 CellChangeTimes->{{3.819277225824806*^9, 3.8192772691920624`*^9}, {
  3.8192774619298153`*^9, 3.8192774694606686`*^9}, {3.819277595097565*^9, 
  3.8192775968139324`*^9}},
 FontSize->11,ExpressionUUID->"10c5fbf5-0f1a-49b9-928f-5bc21bc10a5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SampleA", "=", 
   RowBox[{"Sample", "[", 
    RowBox[{"0.1", ",", "100", ",", "10000"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8177219752455425`*^9, 3.8177220323577595`*^9}, 
   3.817905108019936*^9, 3.8179058606252356`*^9, 3.8192772976205454`*^9, 
   3.8192776044435196`*^9},
 FontSize->11,
 CellLabel->"In[6]:=",ExpressionUUID->"df0393b6-3519-483e-b26d-b3134f2e2bcc"],

Cell[TextData[{
 "The Do command below generates a list of points in a two-dimensional space \
with coordinates drawn from the distributions described previously, where the \
standard deviation of the normal distribution from which the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"f8511188-da9e-43f9-ad3b-8360ad125f2f"],
 " coordinates of the points are drawn has parameters \[Alpha] and \[Beta] \
set to ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]],
  FontSize->11,ExpressionUUID->"058e0633-4c7d-40b3-97a5-cd689c1af315"],
 " and ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]],
  FontSize->11,ExpressionUUID->"ea993528-ed7c-489d-bc87-d48ceb4c5020"],
 " respectively. In this case, the value of \[Beta] is large enough to ensure \
that ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"f244ae81-356b-4338-97a1-0e2849e226c1"],
 " converges to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", "x"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"97281590-05aa-4ec9-a594-c91849aff9de"],
 " for ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"adc2197c-aa14-46f9-96f9-747d074c3f61"],
 " sufficiently close to ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],
  FontSize->11,ExpressionUUID->"c55bac55-c744-4d94-940b-8275d37dc287"],
 " and ",
 Cell[BoxData[
  FormBox["10", TraditionalForm]],
  FontSize->11,ExpressionUUID->"b037797b-70cd-4a85-ac63-e7638d67b05c"],
 ", which makes almost certain that it remains on the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "10"}], "]"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"09f3fd81-ff8b-4826-a3ce-a4a322cbe2f4"],
 " as we move away from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"44d33a29-037e-4813-ba72-c93c06fd688e"],
 ", but also small enough so that we get a sufficiently large number of \
points close to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "5"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"8f1fee24-9a1a-4e45-bd37-16a95d424dd1"],
 " with ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"5bea7588-f0b6-4557-ac47-8782b0246094"],
 " that deviates from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", 
    RowBox[{"1", "-", "x"}]}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"f69c01b1-5a15-4bce-8959-6415546013b4"],
 ". Meanwhile, the value of \[Alpha] is large enough to induce a sufficiently \
large degree of variance in the value of ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"878b4458-9a27-44b5-ad1d-19cd1f69eb47"],
 " for points with ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"12e06e3e-e7ba-401b-9e6d-ae34a0ad1504"],
 " close to ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]],
  FontSize->11,ExpressionUUID->"1355c9c5-1868-4bcf-8111-f84ccfee664d"],
 ", while small enough to ensure that the majority of these points stay on \
the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"0", ",", "10"}], "]"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"d49f6063-8393-42f4-9afd-4b91a0dea851"],
 ", with the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FontSize->11,ExpressionUUID->"c20b58cb-eadc-4574-b17b-f1c0ed898a6e"],
 " coordinates of roughly 95% of such points falling on the interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{"5", "-", 
       RowBox[{"2", "\[Sigma]"}]}], ",", 
      RowBox[{"5", "+", 
       RowBox[{"2", "\[Sigma]"}]}]}], "]"}], "=", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "3"}], ",", "13"}], "]"}]}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"36181131-0506-4e4c-a5f0-d035ceeb33d7"],
 " for the values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"85565ffa-9cc8-485d-8d7c-f3ad1969ff4c"],
 " in question. Note that for such a sprinkling of points in the plane, we \
would expect nodes corresponding to points with ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"6e8ba049-37dd-4d8f-8378-7c9dd4c2e3b7"],
 " coordinates close to ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]],
  FontSize->11,ExpressionUUID->"f4011d2d-ef15-430e-a686-ffeb22363726"],
 " to have both a low in-degree and low out-degree for positive \[Gamma] due \
to the low density of nodes in this region of the plane. Meanwhile, we would \
expect nodes corresponding to points with ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FontSize->11,ExpressionUUID->"8632c3fc-b439-4484-ad9f-9af00b28dd37"],
 " coordinates close to ",
 Cell[BoxData[
  FormBox["10", TraditionalForm]],
  FontSize->11,ExpressionUUID->"4214d7eb-1135-4d93-96b4-4993cd8f76e8"],
 " or close to ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],
  FontSize->11,ExpressionUUID->"6b1c3b41-a908-4d02-a074-36d8cb929167"],
 " to have both a high in-degree and high out-degree for positive \[Gamma] \
due to the high density of nodes in these regions of the plane. Furthermore, \
for this configuration we would expect nodes with a high degree to be \
connected to other nodes with a high degree and vice versa. As a result, for \
positive \[Gamma] we would expect the function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "2"], "[", 
    RowBox[{"p", ",", "\[Gamma]"}], "]"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"b89282d9-bea0-44ad-b3c0-f0e0eca57630"],
 " to generate an adjacency matrix that corresponds to an assortative \
network, with the assortativity of the network increasing in \[Gamma]. \
Conversely, by the same reasoning, for negative \[Gamma] we would expect the \
function in question to generate an adjacency matrix that corresponds to a \
disassortative network, with the assortativity of the network decreasing in \
the absolute value of \[Gamma]. Now, once the command below has generated the \
list of points corresponding to our chosen distributions, it produces an \
adjacency matrix for a network where the probability of a link between two \
nodes existing depends on the geometric distance between the points \
corresponding to the nodes in question in the desired manner, and appends \
this adjacency matrix to a list. The command repeats this process ",
 Cell[BoxData[
  FormBox["10000", TraditionalForm]],
  FontSize->11,ExpressionUUID->"c1809b95-699b-4d63-b15d-bda4bf1372bc"],
 " times to produce a sample of ",
 Cell[BoxData[
  FormBox["10000", TraditionalForm]],
  FontSize->11,ExpressionUUID->"080a3b71-3728-4a9f-9434-7ec4014d64b2"],
 " networks, each of which corresponds to a different scattering of points \
with coordinates drawn from the distributions specified above. The reason \
that we don\[CloseCurlyQuote]t generate a sample of networks according to one \
draw of ",
 Cell[BoxData[
  FormBox["100", TraditionalForm]],
  FontSize->11,ExpressionUUID->"a5ff3a99-67d5-45fe-b58b-251c44566725"],
 " points in the plane is due to the possibility that such a scattering is an \
outlier and thus not representative of the class of networks in question. \
Thus, we have two sources of randomness entering into the sample generated \
below:"
}], "Text",
 CellChangeTimes->{{3.8192776088048506`*^9, 3.81927762674186*^9}, {
   3.8192776611368403`*^9, 3.8192776845571737`*^9}, {3.8192778840644226`*^9, 
   3.8192780197792845`*^9}, {3.8192782071190586`*^9, 3.819278254235993*^9}, {
   3.819278284512986*^9, 3.819278306619851*^9}, 3.8192807594582467`*^9, {
   3.819281092497197*^9, 3.8192812421238775`*^9}, {3.819281489349416*^9, 
   3.8192815061175528`*^9}, {3.8192815390933576`*^9, 
   3.8192815862820816`*^9}, {3.819281624672936*^9, 3.819281775981101*^9}, {
   3.8192818125622*^9, 3.8192818901945257`*^9}, {3.819281938452381*^9, 
   3.819281967401927*^9}, {3.819282686925832*^9, 3.8192827678822308`*^9}, {
   3.819282942265667*^9, 3.8192829906482534`*^9}, {3.819283171764677*^9, 
   3.819283179918826*^9}, {3.819283712801124*^9, 3.8192837142272778`*^9}, {
   3.8192837839407573`*^9, 3.8192838367943788`*^9}, {3.819283915875764*^9, 
   3.8192839288431053`*^9}, {3.8192839604814568`*^9, 
   3.8192840902313104`*^9}, {3.8192841271694455`*^9, 3.819284221968809*^9}, {
   3.819284327974228*^9, 3.8192843830757675`*^9}, {3.8192844940408773`*^9, 
   3.8192848127421894`*^9}, {3.8192848512322087`*^9, 3.819284874613655*^9}, {
   3.819284948500967*^9, 3.8192849520165596`*^9}, {3.8192849852217293`*^9, 
   3.8192850065097637`*^9}, {3.8192850632410145`*^9, 
   3.8192851695605173`*^9}, {3.819285382636431*^9, 3.8192854032642736`*^9}, {
   3.8192854725349064`*^9, 3.81928554781453*^9}, {3.819285636427411*^9, 
   3.8192856994577727`*^9}, {3.819285750621913*^9, 3.8192857590423555`*^9}, {
   3.8192858056816063`*^9, 3.819285854022266*^9}, {3.819624407919905*^9, 
   3.819624485325875*^9}, {3.8196245400056286`*^9, 3.8196245459048643`*^9}, {
   3.819624590605295*^9, 3.8196245912336493`*^9}, {3.81963712551703*^9, 
   3.819637156761427*^9}, {3.819637191603239*^9, 3.8196371922535*^9}, {
   3.819637617443085*^9, 3.8196376397852926`*^9}, {3.8196377524938755`*^9, 
   3.8196377819879904`*^9}, {3.8196378174142413`*^9, 3.81963782047206*^9}},
 FontSize->11,ExpressionUUID->"a1d5315e-c804-4a20-8024-6333cece9c02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SampleB", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Nodes", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"Y", "[", 
       RowBox[{"4", ",", "5", ",", "100"}], "]"}], ",", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"SampleB", ",", 
        RowBox[{
         SubscriptBox["A", "2"], "[", 
         RowBox[{"0.1", ",", "0.75"}], "]"}]}], "]"}]}], "}"}], ",", 
    "10000"}], "]"}]}]], "Input",
 FontSize->11,
 CellLabel->"In[7]:=",ExpressionUUID->"1450433e-fd1e-44ef-bbe7-e61e216f5008"],

Cell[TextData[{
 "We now introduce the matrix ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],
  FontSize->11,ExpressionUUID->"5cbefb04-044b-48e4-867f-1278f7810e5a"],
 ", which has the property that all of its elements, with the exception of \
those on its diagonal, take a value of ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],
  FontSize->11,ExpressionUUID->"aad61477-3ad3-4d88-bbfa-d16352eb3414"],
 ". Then, for an unweighted adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FontSize->11,ExpressionUUID->"3379765d-c071-4afb-b0c2-503cd48ddbbb"],
 ", element ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"k", ",", "k"}], ")"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"d6a9fd98-c24c-4029-8555-8d9a049abe77"],
 " of the matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", ".", "Q", ".", "A"}], TraditionalForm]],
  FontSize->11,ExpressionUUID->"e1f7c95d-6d68-4782-ab42-b160c92aed60"],
 " yields the number of two step paths through node ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]],
  FontSize->11,ExpressionUUID->"48783405-f85d-4c18-9407-f029df765777"],
 " of the network corresponding to the adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FontSize->11,ExpressionUUID->"0059d6fc-5880-47b7-bb22-d010bfdc1d6f"],
 " excluding two step closed paths as required for the computation of the \
Newman clustering coefficient:"
}], "Text",
 CellChangeTimes->{{3.8193688085097256`*^9, 3.819368884659027*^9}, {
  3.819624606183629*^9, 3.8196246254989805`*^9}, {3.81962467706209*^9, 
  3.819624677093971*^9}, {3.8196379546341953`*^9, 3.819637965034382*^9}},
 FontSize->11,ExpressionUUID->"6d92b24a-0755-4910-83cf-674d3db0bfc2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Q", "[", "n_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{"1", ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], "-", 
   RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]], "Input",
 CellChangeTimes->{3.817902290089945*^9},
 FontSize->11,
 CellLabel->
  "In[681]:=",ExpressionUUID->"1d013e1d-4857-4253-965a-a03db7dcd464"],

Cell[TextData[{
 "The function below now computes the Newman clustering coefficient, which is \
defined as the ratio of the total number of triangles (where we count \
triangles which are undirected twice) to the total number of two step paths \
for a network corresponding to the adjacency matrix ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "9eb8bad8-5d0a-4730-9ffe-0d00a63c9cf5"],
 ":"
}], "Text",
 CellChangeTimes->{{3.8193688910877886`*^9, 3.8193688930365767`*^9}, {
  3.8193708792051535`*^9, 3.8193710010980334`*^9}},
 FontSize->11,ExpressionUUID->"77c7f919-5560-4b9d-92f1-bb4e49621584"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NewmanClustering", "[", "A_", "]"}], ":=", 
  FractionBox[
   RowBox[{
    FractionBox["1", "3"], 
    RowBox[{"Tr", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{"A", ",", "3"}], "]"}], "]"}]}], 
   RowBox[{"Tr", "[", 
    RowBox[{"A", ".", 
     RowBox[{"Q", "[", 
      RowBox[{"Length", "[", "A", "]"}], "]"}], ".", "A"}], "]"}]]}]], "Input",
 CellChangeTimes->{{3.817902324511548*^9, 3.8179023501155057`*^9}, {
  3.8179024340663977`*^9, 3.817902528858471*^9}},
 FontSize->11,
 CellLabel->"In[9]:=",ExpressionUUID->"e7aa186d-b0c8-413c-9693-dcfc23849e80"],

Cell["\<\
The following commands calculate the Newman clustering coefficient for every \
network in SampleA and SampleB respectively:\
\>", "Text",
 CellChangeTimes->{{3.8193710191257944`*^9, 3.81937103685636*^9}},
 FontSize->11,ExpressionUUID->"0613c5f4-56f4-4335-b99d-73ff7eac5a43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NC1", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"NewmanClustering", ",", "SampleA"}], "]"}]}], ";", 
  RowBox[{"NC2", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"NewmanClustering", ",", "SampleB"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.817902557566996*^9, 3.817902604027646*^9}, 
   3.8190396274523053`*^9},
 FontSize->11,
 CellLabel->"In[10]:=",ExpressionUUID->"b3d1edd5-aed6-4a93-861a-2cbae10301cb"],

Cell["\<\
Below are the distributions for the Newman clustering coefficient across \
SampleA (leftmost figure) and SampleB (rightmost figure):\
\>", "Text",
 CellChangeTimes->{{3.8193710559382877`*^9, 3.8193710858941193`*^9}, {
   3.819553276722865*^9, 3.8195532794577603`*^9}, 3.8196247000186977`*^9},
 FontSize->11,ExpressionUUID->"cbbca451-2969-4b4c-97e9-5d5a9c16be08"],

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{"NC1", ",", "\"\<Probability\>\"", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<NC\>\"", ",", "\"\<P(NC)\>\""}], "}"}]}]}], "]"}], ",", 
     RowBox[{"Histogram", "[", 
      RowBox[{"NC2", ",", "\"\<Probability\>\"", ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<NC\>\"", ",", "\"\<P(NC)\>\""}], "}"}]}]}], "]"}]}], 
    "}"}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.8179141516757126`*^9, 3.8179141534628973`*^9}, {
  3.8190395665572925`*^9, 3.8190395824194527`*^9}, {3.8196222507194867`*^9, 
  3.8196222565409565`*^9}, {3.819622350660186*^9, 3.8196224360019293`*^9}},
 FontSize->11,
 CellLabel->
  "In[859]:=",ExpressionUUID->"281873c6-38de-4e76-bb93-731f9e41b748"],

